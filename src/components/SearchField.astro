---
import { useTranslations, defaultLang, type Lang } from '~/i18n';
interface Props { placeholder: string; lang?: Lang; id?: string }
const { placeholder, lang = defaultLang, id = 'q' } = Astro.props;
const t = useTranslations(lang);
---
<form class="search" role="search" action="" data-search-form onsubmit="return false">
  <label class="visually-hidden" for={id}>{t('search.label')}</label>
  <input
    class="search__input"
    id={id}
    name="q"
    type="search"
    placeholder={placeholder}
    autocomplete="off"
    spellcheck="false"
    enterkeyhint="search"
    data-search-input
  />
  <kbd class="kbd" aria-hidden="true">/</kbd>
  <button class="search__clear" type="button" aria-label={t('search.clear')} data-search-clear>✕</button>
</form>
