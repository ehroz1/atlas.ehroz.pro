---
import { u, pagePath } from '~/lib/url';
/**
 * Floating top bar: brand · Sites|Wall · search & filter · Submit · menu.
 *
 * The search pill opens the finder dialog (search field + facets).
 * State: { q, category[], pricing[], platform[] }, mirrored in the URL.
 * - On pages with a grid (home, category) results filter in place: the
 *   header fires `atlas:filter` with the matching ids; Gallery listens.
 * - Elsewhere, Done opens the home grid with the same URL params, and
 *   typed queries list matching sites to jump to directly.
 */
import { getImage } from 'astro:assets';
import { getTools, getCategories, searchText, domainOf } from '~/lib/data';
import { shotFor } from '~/lib/shots';
import { useTranslations, loc, defaultLang, type Lang } from '~/i18n';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const path = pagePath(Astro.url.pathname);

const [tools, categories] = await Promise.all([getTools(), getCategories()]);
const names = new Map(categories.map((c) => [c.id, loc(c.data.name, lang)]));
const count = <T,>(list: T[], fn: (x: T) => boolean) => list.filter(fn).length;

const platforms = [...new Set(tools.flatMap((x) => x.data.platforms))].sort(
  (a, b) => count(tools, (x) => x.data.platforms.includes(b)) - count(tools, (x) => x.data.platforms.includes(a)),
);

// small thumbnails for search results
const thumbs = new Map<string, string>();
for (const tool of tools) {
  const shot = shotFor(tool.id);
  if (shot) thumbs.set(tool.id, (await getImage({ src: shot, width: 240, format: 'webp', quality: 70 })).src);
}

const index = {
  tools: tools.map((tool) => ({
    id: tool.id,
    name: tool.data.name,
    category: tool.data.category,
    categoryName: names.get(tool.data.category),
    pricing: tool.data.pricing,
    open: tool.data.openSource,
    platforms: tool.data.platforms,
    summary: loc(tool.data.summary, lang),
    text: searchText(tool, names.get(tool.data.category)!),
    thumb: thumbs.get(tool.id) ?? '',
    domain: domainOf(tool.data.url),
  })),
  facets: {
    category: categories.map((c) => ({ id: c.id, label: loc(c.data.name, lang), count: count(tools, (x) => x.data.category === c.id) })),
    pricing: [
      ...(['free', 'freemium', 'paid'] as const).map((p) => ({ id: p, label: t(`pricing.${p}`), count: count(tools, (x) => x.data.pricing === p) })),
      { id: 'open', label: t('pricing.openSource'), count: count(tools, (x) => x.data.openSource) },
    ],
    platform: platforms.map((p) => ({ id: p, label: p, count: count(tools, (x) => x.data.platforms.includes(p)) })),
  },
  strings: {
    category: t('search.facet.category'),
    pricing: t('search.facet.pricing'),
    platform: t('search.facet.platform'),
    sites: t('search.sites'),
    none: t('search.none'),
    placeholder: t('search.placeholder'),
    tabSites: t('search.sites'),
    tabCategories: t('nav.categories'),
    noCategories: t('search.noCategories'),
    filtersOne: t('search.filters.one'),
    filtersOther: t('search.filters.other'),
  },
};

const section = path === '/wall' ? 'wall' : path === '/' || path.startsWith('/tool/') || path.startsWith('/categor') ? 'sites' : null;
---
<header class="site-header">
  <div class="site-header__inner">
    <div class="bar-group">
      <a class="bar-logo" href={u('/')} aria-label={t('nav.home')} data-home>
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M18.6 3.6c6 1.2 9.9 6.6 9.4 12.7-.5 6.6-6 11.6-12.7 11.3C8.7 27.3 3.8 21.7 4.1 15.1 4.5 8.7 9.8 3.7 16.2 3.5c.8 0 1.6 0 2.4.1"/>
          <path d="M13.2 4.4c-2.8 4-3.7 9.1-2.4 13.9 1 3.7 3.2 6.9 6 9.1"/>
          <path d="M4.8 14.2c4 2 8.9 3.1 13.9 2.6 3.4-.3 6.5-1.2 9.2-2.7"/>
          <path d="M18.4 7.6c1.6-.5 3.3.1 3.9 1.3.5 1-.3 1.8 0 2.7.3.8 1.4 1.1 1.3 2-.1.8-1.4 1-2.4.6-1-.4-1.4-1.4-2.4-1.6-.9-.2-1.9.1-2.4-.6-.7-1.1-.1-3.6 2-4.4Z"/>
        </svg>
        <span class="bar-logo__word">Atlas<span class="bar-logo__more" aria-hidden="true">.ehroz.pro</span><sup>°</sup></span>
      </a>
      <nav class="segmented" aria-label={t('nav.sections')}>
        <a class="segmented__item" href={u('/')} aria-current={section === 'sites' ? 'page' : undefined}>{t('nav.sites')}</a>
        <a class="segmented__item" href={u('/wall')} aria-current={section === 'wall' ? 'page' : undefined}>{t('nav.wall')}</a>
      </nav>
    </div>

    <div class="bar-search">
      <button class="bar-search__field" type="button" aria-haspopup="dialog" aria-controls="finder" data-finder-open>
        <svg class="bar-search__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="8.6" cy="8.6" r="6"/><path d="m13.2 13.2 4.3 4.3"/>
        </svg>
        <span class="bar-search__label" data-finder-label>{t('search.placeholder')}</span>
        <span class="bar-search__badge" data-finder-badge hidden></span>
        <kbd class="kbd" aria-hidden="true">/</kbd>
      </button>
    </div>

    <div class="bar-group bar-group--end">
      <a class="btn btn--bar btn--chrome" href={u('/submit')} aria-current={path === '/submit' ? 'page' : undefined}>
        <span class="only-wide">{t('nav.submit')}</span><span class="only-narrow">{t('nav.submitShort')}</span>
      </a>
      <div class="bar-menu">
        <button class="bar-icon" type="button" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <path d="M5 8.5h14M5 15.5h14"/>
          </svg>
        </button>
        <nav class="menu" id="site-menu" aria-label={t('nav.menu')} hidden data-menu>
          <a class="menu__item" href={u('/about')} aria-current={path === '/about' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 11v5"/><path d="M12 7.8v.1"/></svg>
            {t('nav.about')}
          </a>
          <a class="menu__item" href={u('/categories')} aria-current={path === '/categories' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/></svg>
            {t('nav.categories')}
          </a>
          <a class="menu__item" href={u('/wall')} aria-current={path === '/wall' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="7" height="5" rx="1"/><rect x="13.5" y="5" width="7" height="5" rx="1"/><rect x="7.5" y="14" width="9" height="5" rx="1"/></svg>
            {t('nav.wall')}
          </a>
          <a class="menu__item" href={u('/submit')} aria-current={path === '/submit' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            {t('nav.submit')}
          </a>
          <hr class="menu__sep" />
          <p class="menu__note"><kbd class="kbd">/</kbd> {t('menu.shortcut')}</p>
        </nav>
      </div>
    </div>
  </div>
</header>

<dialog class="finder" id="finder" aria-label={t('search.label')} data-finder>
  <form class="finder__field" role="search" method="dialog" onsubmit="return false">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <circle cx="8.6" cy="8.6" r="6"/><path d="m13.2 13.2 4.3 4.3"/>
    </svg>
    <label class="visually-hidden" for="finder-input">{t('search.label')}</label>
    <input class="finder__input" id="finder-input" type="search" placeholder={t('search.input')}
      autocomplete="off" spellcheck="false" enterkeyhint="search" data-finder-input />
    <button class="finder__x" type="button" aria-label={t('search.clear')} data-finder-x hidden>
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15"/></svg>
    </button>
  </form>
  <div class="finder__body">
    <div class="finder__facets" role="tablist" aria-label="Filters">
      <button class="finder__facet" type="button" role="tab" aria-selected="true" data-facet="category">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2.5"/><path d="M8 15.5h3"/><circle cx="9" cy="9" r="1.2"/></svg>
        {t('search.facet.category')}<span class="finder__facet-count" data-facet-count="category"></span>
      </button>
      <button class="finder__facet" type="button" role="tab" aria-selected="false" data-facet="pricing">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5V5h7.5L20 13.5 13.5 20 4 12.5Z"/><circle cx="8.5" cy="8.5" r="1.2"/></svg>
        {t('search.facet.pricing')}<span class="finder__facet-count" data-facet-count="pricing"></span>
      </button>
      <button class="finder__facet" type="button" role="tab" aria-selected="false" data-facet="platform">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="11" rx="1.8"/><path d="M9 19.5h6M12 16v3.5"/></svg>
        {t('search.facet.platform')}<span class="finder__facet-count" data-facet-count="platform"></span>
      </button>
    </div>
    <div class="finder__pane" role="tabpanel" data-finder-pane></div>
  </div>
  <div class="finder__foot">
    <button class="finder__clear" type="button" data-finder-clear hidden>{t('search.clearAll')}</button>
    <div class="finder__foot-end">
      <button class="finder__lucky" type="button" title={t('search.luckyHint')} data-finder-lucky>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
          <rect x="3.5" y="3.5" width="13" height="13" rx="3"/>
          <circle cx="7.4" cy="7.4" r="0.9" fill="currentColor" stroke="none"/><circle cx="12.6" cy="12.6" r="0.9" fill="currentColor" stroke="none"/>
          <circle cx="12.6" cy="7.4" r="0.9" fill="currentColor" stroke="none"/><circle cx="7.4" cy="12.6" r="0.9" fill="currentColor" stroke="none"/>
        </svg>
        <span class="finder__lucky-text">{t('search.lucky')}</span>
      </button>
      <button class="finder__done" type="button" data-finder-done>{t('search.done')}</button>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" id="search-index" set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />

<script>
  type Tool = {
    id: string; name: string; category: string; categoryName: string; pricing: string;
    open: boolean; platforms: string[]; summary: string; text: string; thumb: string; domain: string;
  };
  type Option = { id: string; label: string; count: number };
  type FacetKey = 'category' | 'pricing' | 'platform';
  type Index = { tools: Tool[]; facets: Record<FacetKey, Option[]>; strings: Record<string, string> };
  type State = { q: string } & Record<FacetKey, Set<string>>;

  const data: Index = JSON.parse(document.getElementById('search-index')!.textContent!);
  const S = data.strings;
  const FACETS: FacetKey[] = ['category', 'pricing', 'platform'];

  const dialog = document.querySelector<HTMLDialogElement>('[data-finder]')!;
  const input = document.querySelector<HTMLInputElement>('[data-finder-input]')!;
  const pane = document.querySelector<HTMLElement>('[data-finder-pane]')!;
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-finder-clear]')!;
  const luckyBtn = document.querySelector<HTMLButtonElement>('[data-finder-lucky]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-finder-open]')!;
  const label = document.querySelector<HTMLElement>('[data-finder-label]')!;
  const badge = document.querySelector<HTMLElement>('[data-finder-badge]')!;

  /* URLs are built from the logo's href, which already carries the site's
     base ("/", "/atlas.ehroz.pro/") or, in a static copy, "../index.html". */
  const home = document.querySelector<HTMLAnchorElement>('[data-home]')!.getAttribute('href')!;
  const fileMode = home.endsWith('index.html');
  const base = fileMode ? home.replace(/index\.html$/, '') : home.endsWith('/') ? home : home + '/';
  const pageUrl = (p: string, query = '') =>
    base + (p ? p + (fileMode ? '/index.html' : '') : fileMode ? 'index.html' : '') + query;

  const grid = () => document.querySelector<HTMLElement>('[data-cards]');
  const scope = document.querySelector<HTMLElement>('[data-scope-category]')?.dataset.scopeCategory;

  const normalize = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').trim();
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const CHECK = '<svg class="finder__check" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 10.5 3.5 3.5 7.5-8"/></svg>';

  // ---- state ---------------------------------------------------------
  const state: State = { q: '', category: new Set(), pricing: new Set(), platform: new Set() };
  const params = new URLSearchParams(location.search);
  state.q = params.get('q') ?? '';
  for (const f of FACETS) (params.get(f) ?? '').split(',').filter(Boolean).forEach((v) => state[f].add(v));
  if (scope && !state.category.size) state.category.add(scope);

  let facet: FacetKey = 'category';
  const filterCount = () =>
    FACETS.reduce((n, f) => n + state[f].size, 0) - (scope && state.category.size === 1 && state.category.has(scope) ? 1 : 0);

  function matches(tool: Tool) {
    const words = normalize(state.q).split(/\s+/).filter(Boolean);
    const hay = normalize(tool.text);
    if (!words.every((w) => hay.includes(w))) return false;
    if (state.category.size && !state.category.has(tool.category)) return false;
    if (state.pricing.size && !(state.pricing.has(tool.pricing) || (state.pricing.has('open') && tool.open))) return false;
    if (state.platform.size && !tool.platforms.some((p) => state.platform.has(p))) return false;
    return true;
  }

  // Filtering in place works when the page has a grid and, on a category
  // page, the category selection is still just that category.
  const inPlace = () =>
    !!grid() && (!scope || (state.category.size === 1 && state.category.has(scope)));

  function queryString() {
    const p = new URLSearchParams();
    if (state.q.trim()) p.set('q', state.q.trim());
    for (const f of FACETS) if (state[f].size && !(f === 'category' && scope && inPlace())) p.set(f, [...state[f]].join(','));
    const s = p.toString();
    return s ? '?' + s : '';
  }

  function emit() {
    const ids = new Set(data.tools.filter(matches).map((x) => x.id));
    const detail = { ids, q: state.q };
    (window as any).__atlasFilter = detail;
    document.dispatchEvent(new CustomEvent('atlas:filter', { detail }));
    try {
      history.replaceState(history.state, '', location.pathname + queryString() + location.hash);
    } catch {
      /* sandboxed frames may refuse history changes */
    }
  }

  // ---- rendering -----------------------------------------------------
  function renderBar() {
    const n = filterCount();
    label.textContent = state.q.trim() || S.placeholder;
    openBtn.classList.toggle('is-active', !!state.q.trim() || n > 0);
    badge.hidden = n === 0;
    badge.textContent = String(n);
    badge.title = (n === 1 ? S.filtersOne : S.filtersOther).replace('{count}', String(n));
    clearBtn.hidden = !state.q.trim() && n === 0;
    luckyBtn.disabled = !data.tools.some(matches);
    for (const f of FACETS) {
      const el = document.querySelector<HTMLElement>(`[data-facet-count="${f}"]`)!;
      el.textContent = state[f].size ? String(state[f].size) : '';
    }
  }

  let active = -1;
  let resultTab: 'sites' | 'categories' = 'sites';
  const xBtn = document.querySelector<HTMLButtonElement>('[data-finder-x]')!;
  function renderPane() {
    document.querySelectorAll<HTMLElement>('[data-facet]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.facet === facet)));
    dialog.classList.toggle('is-searching', !!state.q.trim());
    xBtn.hidden = !input.value;
    if (state.q.trim()) {
      // Typing: tabs with counts, then results with thumbnails.
      const hits = data.tools.filter(matches);
      const words = normalize(state.q).split(/\s+/).filter(Boolean);
      const cats = data.facets.category.filter((c) => words.every((w) => normalize(c.label).includes(w)));
      const tab = (id: 'sites' | 'categories', label: string, n: number) =>
        `<button class="finder__tab" type="button" role="tab" aria-selected="${resultTab === id}" data-tab="${id}">${esc(label)}<span class="finder__tab-count">${n}</span></button>`;
      let list = '';
      if (resultTab === 'sites') {
        list = hits.length
          ? hits
              .slice(0, 40)
              .map(
                (h) => `<a class="finder__result" href="${pageUrl('tool/' + h.id)}" aria-selected="false">
                  <span class="finder__thumb">${h.thumb ? `<img src="${h.thumb}" alt="" loading="lazy" decoding="async">` : `<span>${esc(h.domain)}</span>`}</span>
                  <span class="finder__result-text"><span class="finder__result-name">${esc(h.name)}</span>
                  <span class="finder__result-meta">${esc(h.categoryName)} · ${esc(h.summary)}</span></span></a>`,
              )
              .join('')
          : `<p class="finder__empty">${esc(S.none)}</p>`;
      } else {
        list = cats.length
          ? cats
              .map(
                (c) => `<a class="finder__result finder__result--cat" href="${pageUrl('category/' + c.id)}" aria-selected="false">
                  <span class="finder__result-name">${esc(c.label)}</span><span class="finder__count">${c.count}</span></a>`,
              )
              .join('')
          : `<p class="finder__empty">${esc(S.noCategories)}</p>`;
      }
      pane.innerHTML = `<div class="finder__tabs" role="tablist">${tab('sites', S.tabSites, hits.length)}${tab('categories', S.tabCategories, cats.length)}</div>${list}`;
      active = -1;
      return;
    }
    pane.innerHTML =
      `<div class="finder__label">${esc(S[facet])}</div>` +
      data.facets[facet]
        .map(
          (o) => `<button class="finder__option" type="button" aria-pressed="${state[facet].has(o.id)}" data-option="${esc(o.id)}">
            ${CHECK}<span>${esc(o.label)}</span><span class="finder__count">${o.count}</span></button>`,
        )
        .join('');
  }

  function update() {
    renderBar();
    renderPane();
    if (inPlace()) emit();
  }

  // ---- events --------------------------------------------------------
  function open() {
    input.value = state.q;
    renderPane();
    if (!dialog.open) dialog.showModal();
    input.focus();
    input.select();
  }
  function done() {
    flush();
    dialog.close();
    if (inPlace()) {
      emit();
      if (state.q.trim() || filterCount()) document.getElementById('sites')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else if (state.q.trim() || filterCount()) {
      location.href = pageUrl('', queryString() + '#sites');
    }
  }

  openBtn.addEventListener('click', open);
  document.querySelector('[data-finder-done]')!.addEventListener('click', done);
  clearBtn.addEventListener('click', () => {
    state.q = '';
    input.value = '';
    for (const f of FACETS) state[f].clear();
    if (scope) state.category.add(scope);
    update();
    input.focus();
  });
  document.addEventListener('atlas:reset', () => clearBtn.click());

  // Feeling lucky: a random site among what the query and filters match
  // (everything when nothing is set). Sites not opened yet come first.
  luckyBtn.addEventListener('click', () => {
    flush();
    const pool = data.tools.filter(matches);
    if (!pool.length) return;
    const seen: Set<string> = (window as any).__atlasSeen ?? new Set();
    const here = document.body.dataset.tool;
    const fresh = pool.filter((x) => !seen.has(x.id) && x.id !== here);
    const from = fresh.length ? fresh : pool.filter((x) => x.id !== here).length ? pool.filter((x) => x.id !== here) : pool;
    const pick = from[Math.floor(Math.random() * from.length)];
    location.href = pageUrl('tool/' + pick.id);
  });

  // Wait until the person stops typing before showing results.
  const DEBOUNCE = 300;
  let pending: number | undefined;
  const flush = () => {
    clearTimeout(pending);
    pending = undefined;
    if (state.q === input.value) return;
    state.q = input.value;
    resultTab = 'sites';
    update();
  };
  input.addEventListener('input', () => {
    xBtn.hidden = !input.value;
    clearTimeout(pending);
    // clearing the field shows the filters again straight away
    if (!input.value) return flush();
    pending = window.setTimeout(flush, DEBOUNCE);
  });
  xBtn.addEventListener('click', () => {
    input.value = '';
    flush();
    input.focus();
  });
  pane.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement).closest<HTMLElement>('[data-tab]');
    if (!tab) return;
    resultTab = tab.dataset.tab as 'sites' | 'categories';
    renderPane();
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === 'ArrowDown' || e.key === 'ArrowUp') flush();
    const hits = Array.from(pane.querySelectorAll<HTMLAnchorElement>('.finder__result'));
    if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && hits.length) {
      e.preventDefault();
      active = (active + (e.key === 'ArrowDown' ? 1 : -1) + hits.length) % hits.length;
      hits.forEach((h, i) => h.setAttribute('aria-selected', String(i === active)));
      hits[active].scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (hits[active]) location.href = hits[active].href;
      else done();
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-facet]').forEach((b) =>
    b.addEventListener('click', () => {
      facet = b.dataset.facet as FacetKey;
      if (state.q.trim()) {
        // show the options of the facet the user picked, keep the query
        const q = state.q;
        state.q = '';
        renderPane();
        state.q = q;
      } else renderPane();
    }),
  );
  pane.addEventListener('click', (e) => {
    const opt = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-option]');
    if (!opt) return;
    const set = state[facet];
    const id = opt.dataset.option!;
    set.has(id) ? set.delete(id) : set.add(id);
    renderBar();
    opt.setAttribute('aria-pressed', String(set.has(id)));
    if (inPlace()) emit();
  });
  // click on the dimmed backdrop closes like Done
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) done();
  });
  dialog.addEventListener('cancel', (e) => {
    e.preventDefault();
    done();
  });

  // "/" opens search from anywhere
  document.addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement;
    const typing = el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName);
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !dialog.open) {
      e.preventDefault();
      open();
    }
  });

  // ---- menu ----------------------------------------------------------
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const setMenu = (show: boolean) => {
    menu.hidden = !show;
    menuBtn.setAttribute('aria-expanded', String(show));
  };
  menuBtn.addEventListener('click', () => setMenu(menu.hidden));
  document.addEventListener('pointerdown', (e) => {
    if (!menu.hidden && !menu.parentElement!.contains(e.target as Node)) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setMenu(false);
      menuBtn.focus();
    }
  });

  // ---- initial -------------------------------------------------------
  renderBar();
  if (inPlace() && (state.q || filterCount())) emit();
</script>
