---
import { u } from '~/lib/url';
/**
 * Home hero: 14 screenshots on one ellipse, turning slowly
 * counter-clockwise, with the statement and blue button in the middle
 * (matches deck.gallery's ring).
 *
 * Shots sit at equal angles (360° / 14), not equal distances: on a wide
 * ellipse that bunches them into overlapping stacks at the sides and
 * spreads them along the top and bottom, which is the look we want. The
 * ellipse runs through the panel's top and bottom edges and slightly past
 * its sides, so those shots are cut off by the panel. With reduced motion
 * they are placed on the same track and stay still; without JavaScript
 * only the statement shows.
 */
import { Image } from 'astro:assets';
import { shotFor } from '~/lib/shots';
import type { Tool } from '~/lib/data';
import { useTranslations, defaultLang, type Lang } from '~/i18n';

interface Props { tools: Tool[]; categoryCount: number; lang?: Lang }
const { tools, categoryCount, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const COUNT = 14; // as in the reference ring
const withShots = tools.filter((tool) => shotFor(tool.id));
// spread the picks across the list so neighbours differ
const items = Array.from({ length: COUNT }, (_, i) => withShots[Math.floor((i * withShots.length) / COUNT) % withShots.length]);
---
<section class="hero-panel" aria-labelledby="hero-title" data-hero>
  <div class="collage" aria-hidden="true">
    {items.map((tool) => (
      <div class="collage__item">
        <Image src={shotFor(tool.id)!} alt="" widths={[320, 480]} sizes="(min-width: 48rem) 15vw, 26vw" format="webp" quality={72} loading="eager" />
      </div>
    ))}
  </div>
  <div class="hero-panel__content">
    <h1 class="hero-panel__title" id="hero-title">{t('hero.title', { count: tools.length })}</h1>
    <p class="hero-panel__sub">{t('hero.sub', { categories: categoryCount })}</p>
    <a class="btn btn--accent hero-panel__cta" href={u('/submit')}>{t('hero.cta')}</a>
  </div>
</section>

<script>
  const panel = document.querySelector<HTMLElement>('[data-hero]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (panel) {
    const items = Array.from(panel.querySelectorAll<HTMLElement>('.collage__item'));
    const TURN = 80; // seconds per full turn
    const N = items.length;

    let cx = 0, cy = 0, rx = 0, ry = 0, tw = 0, th = 0;
    const measure = () => {
      const W = panel.clientWidth;
      const H = panel.clientHeight;
      tw = items[0].offsetWidth;
      th = items[0].offsetHeight;
      cx = W / 2;
      cy = H / 2;
      // Side stacks poke a little past the edges; top/bottom shots are cut by them.
      rx = W >= 768 ? W / 2 - tw * 0.35 : W / 2 + tw * 0.1;
      ry = H / 2 - th * 0.12;
    };

    let t = 0;
    const draw = () => {
      const turn = -(t / TURN) * Math.PI * 2; // negative = counter-clockwise on screen
      for (let i = 0; i < N; i++) {
        const a = turn + (i / N) * Math.PI * 2;
        const x = cx + rx * Math.cos(a);
        const y = cy + ry * Math.sin(a);
        items[i].style.transform = `translate3d(${x - tw / 2}px, ${y - th / 2}px, 0)`;
      }
    };

    let running = false;
    let visible = true;
    let last = 0;
    const frame = (now: number) => {
      if (!running) return;
      t += Math.min(0.05, (now - last) / 1000);
      last = now;
      draw();
      requestAnimationFrame(frame);
    };
    const start = () => {
      if (running || !visible || reduced.matches) return;
      running = true;
      last = performance.now();
      requestAnimationFrame(frame);
    };
    const stop = () => { running = false; };

    panel.classList.add('is-live');
    measure();
    draw();
    start();

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      visible ? start() : stop();
    }).observe(panel);
    new ResizeObserver(() => { measure(); draw(); }).observe(panel);
    reduced.addEventListener('change', () => (reduced.matches ? stop() : start()));
  }
</script>
