---
import { u } from '~/lib/url';
/**
 * Home hero: one chain of screenshots running round a single, even
 * ellipse, like a train, with the statement and blue button in the middle.
 *
 * The ellipse touches the panel's top and bottom edges (those shots are
 * half cut off) and its sides. Shots are spaced by equal arc length, and
 * their number is always even, so the ring is mirror-symmetric at every
 * moment. They move clockwise. With reduced motion
 * they are placed on the same track and stay still; without JavaScript
 * only the statement shows.
 */
import { Image } from 'astro:assets';
import { shotFor } from '~/lib/shots';
import type { Tool } from '~/lib/data';
import { useTranslations, defaultLang, type Lang } from '~/i18n';

interface Props { tools: Tool[]; categoryCount: number; lang?: Lang }
const { tools, categoryCount, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const MAX = 24; // more than any screen needs; extra ones are hidden by the script
const withShots = tools.filter((tool) => shotFor(tool.id));
const items = Array.from({ length: Math.min(MAX, withShots.length * 2) }, (_, i) => withShots[i % withShots.length]);
---
<section class="hero-panel" aria-labelledby="hero-title" data-hero>
  <div class="collage" aria-hidden="true">
    {items.map((tool) => (
      <div class="collage__item">
        <Image src={shotFor(tool.id)!} alt="" widths={[320, 480]} sizes="(min-width: 48rem) 15vw, 22vw" format="webp" quality={72} loading="eager" />
      </div>
    ))}
  </div>
  <div class="hero-panel__content">
    <h1 class="hero-panel__title" id="hero-title">{t('hero.title', { count: tools.length })}</h1>
    <p class="hero-panel__sub">{t('hero.sub', { categories: categoryCount })}</p>
    <a class="btn btn--accent hero-panel__cta" href={u('/submit')}>{t('hero.cta')}</a>
  </div>
</section>

<script>
  const panel = document.querySelector<HTMLElement>('[data-hero]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (panel) {
    const items = Array.from(panel.querySelectorAll<HTMLElement>('.collage__item'));
    const SPEED = 28; // px per second along the track
    const SPACING = 1.12; // distance between shots, in shot widths

    // Ellipse with an arc-length table, so equal steps along the line are
    // equal distances on screen (plain angle steps bunch up at the ends).
    const SAMPLES = 1024;
    let cx = 0, cy = 0, rx = 0, ry = 0, tw = 0, th = 0, P = 0, count = 0;
    const lens = new Float64Array(SAMPLES + 1);
    const build = () => {
      let prevX = rx, prevY = 0;
      lens[0] = 0;
      for (let i = 1; i <= SAMPLES; i++) {
        const a = (i / SAMPLES) * Math.PI * 2;
        const x = rx * Math.cos(a), y = ry * Math.sin(a);
        lens[i] = lens[i - 1] + Math.hypot(x - prevX, y - prevY);
        prevX = x;
        prevY = y;
      }
      P = lens[SAMPLES];
    };
    /** Point at distance s along the ellipse, clockwise from the right-hand side. */
    const along = (s: number): [number, number] => {
      s = ((s % P) + P) % P;
      let lo = 0, hi = SAMPLES;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        lens[mid] < s ? (lo = mid + 1) : (hi = mid);
      }
      const i = Math.max(1, lo);
      const f = (s - lens[i - 1]) / (lens[i] - lens[i - 1] || 1);
      const a = ((i - 1 + f) / SAMPLES) * Math.PI * 2;
      return [cx + rx * Math.cos(a), cy + ry * Math.sin(a)];
    };

    const measure = () => {
      const W = panel.clientWidth;
      const H = panel.clientHeight;
      tw = items[0].offsetWidth;
      th = items[0].offsetHeight;
      cx = W / 2;
      cy = H / 2;
      // Desktop: side shots sit just inside the edges. Phones: half off, to leave room for the text.
      rx = W >= 768 ? W / 2 - tw / 2 : W / 2;
      ry = H / 2; // top and bottom shots are cut in half by the panel edge
      build();
      count = Math.floor(P / (tw * SPACING));
      count = Math.max(4, Math.min(items.length - (items.length % 2), count - (count % 2)));
      items.forEach((el, i) => (el.hidden = i >= count));
    };

    let t = 0;
    const draw = () => {
      const gap = P / count;
      for (let i = 0; i < count; i++) {
        const [x, y] = along(t * SPEED + i * gap);
        items[i].style.transform = `translate3d(${x - tw / 2}px, ${y - th / 2}px, 0)`;
      }
    };

    let running = false;
    let visible = true;
    let last = 0;
    const frame = (now: number) => {
      if (!running) return;
      t += Math.min(0.05, (now - last) / 1000);
      last = now;
      draw();
      requestAnimationFrame(frame);
    };
    const start = () => {
      if (running || !visible || reduced.matches) return;
      running = true;
      last = performance.now();
      requestAnimationFrame(frame);
    };
    const stop = () => { running = false; };

    panel.classList.add('is-live');
    measure();
    draw();
    start();

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      visible ? start() : stop();
    }).observe(panel);
    new ResizeObserver(() => { measure(); draw(); }).observe(panel);
    reduced.addEventListener('change', () => (reduced.matches ? stop() : start()));
  }
</script>
