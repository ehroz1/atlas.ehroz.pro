---
/**
 * An article's cover: its own image (frontmatter `cover`) or the drawn
 * cover from /cover/<lang>/<slug>.png (src/lib/cover.ts).
 */
import { Image } from 'astro:assets';
import { u } from '~/lib/url';
import type { Article } from '~/lib/articles';
import type { Lang } from '~/i18n';

interface Props {
  article: Article;
  lang: Lang;
  /** "hero" on the article page, "card" in lists */
  size?: 'hero' | 'card';
  eager?: boolean;
}
const { article, lang, size = 'card', eager = false } = Astro.props;
const d = article.entry[lang].data;
const hero = size === 'hero';
const loading = eager ? 'eager' : 'lazy';
---
<div class={`article-cover article-cover--${size}`}>
  {d.cover ? (
    <Image
      src={d.cover}
      alt={d.coverAlt ?? ''}
      widths={hero ? [640, 960, 1280, 1600] : [480, 720, 960]}
      sizes={hero ? '(min-width: 48rem) 46rem, 92vw' : '(min-width: 64rem) 30rem, 92vw'}
      format="webp"
      quality={80}
      loading={loading}
      fetchpriority={eager && hero ? 'high' : undefined}
    />
  ) : (
    <img src={u(`/cover/${lang}/${article.slug}.png`)} alt="" width="1600" height="900" loading={loading} decoding="async" fetchpriority={eager && hero ? 'high' : undefined} />
  )}
</div>
