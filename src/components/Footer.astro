---
import { u } from '~/lib/url';
import { getTools, getCategories } from '~/lib/data';
import { useTranslations, defaultLang, formatDate, type Lang } from '~/i18n';
interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const tools = await getTools();
const latest = new Date(Math.max(...tools.map((x) => x.data.added.getTime())));
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container container--wide site-footer__inner">
    <div class="stack" style="--gap: var(--s-1)">
      <span>© {year} Atlas · {t('footer.note')}</span>
      <span>{t('footer.updated', { date: formatDate(latest, lang) })}</span>
    </div>
    <nav class="cluster" style="--gap: var(--s-2) var(--s-5)" aria-label="Footer">
      <a href={u('/')}>{t('filter.all')}</a>
      <a href={u('/about')}>{t('nav.about')}</a>
      <a href={u('/submit')}>{t('nav.submit')}</a>
      <a href={u('/rss.xml')} type="application/rss+xml">{t('footer.rss')}</a>
    </nav>
  </div>
</footer>
