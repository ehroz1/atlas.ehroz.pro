---
/**
 * Hand-drawn line illustration for the hero: a figure holding up a globe
 * (Atlas). Single stroke color via currentColor; set color with
 * .hero__drawing (uses --c-ink-blue). Keep it a line drawing — no fills.
 */
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 170 124" fill="none" stroke="currentColor" stroke-width="2.4"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <!-- globe: outline left slightly open, like a pen lifted -->
  <path d="M92.8 10.4c13.4 2.6 22.3 14.6 21.3 28.4-1.1 14.8-13.6 26.2-28.5 25.5C70.8 63.6 59.6 51 60.4 36.2 61.1 21.9 73 10.6 87.4 10c1.4 0 2.8.1 4.2.3"/>
  <!-- one tilted meridian and an equator -->
  <path d="M80.6 11.6c-6.3 9-8.4 20.6-5.3 31.4 2.4 8.4 7.2 15.4 13.6 20.3"/>
  <path d="M61.4 33.7c8.9 4.6 20 6.9 31.2 5.8 7.6-.7 14.6-2.8 20.6-6"/>
  <!-- a continent, loosely -->
  <path d="M90.4 17.8c3.9-1.6 8.6-1 11.2 1.6 1.9 1.9 1.4 4.1 2.9 5.9 1.4 1.7 3.8 2.6 3.4 4.8-.4 2.1-3.3 2.9-5.8 2.3-2.6-.6-3.8-2.9-6.4-3.6-2.4-.6-5 .3-6.5-1.4-2-2.3-1.6-7.6 1.2-9.6Z"/>
  <path d="M85 47.4c2.8-1.6 6.8-1.3 8.4.9 1.3 1.9.2 4.3-1.9 5.6-2.3 1.4-5.5 1.1-6.9-.8-1-1.4-.9-3.4.4-5.7Z"/>
  <!-- head, bowed under the weight -->
  <path d="M79.3 71.6c4.2-.9 8.2 1.6 8.9 5.6.7 4.1-2.1 8-6.3 8.6-4.1.6-7.8-2.1-8.4-6.1-.5-3.8 2-7.3 5.8-8.1Z"/>
  <!-- arms: elbows out, hands on the globe -->
  <path d="M74.6 88.2c-4.3-1.8-8.2-4.6-10.6-8.6 1-7.2 2.5-14.4 4.6-21.6"/>
  <path d="M89.6 88c4.6-1.9 8.6-4.9 11.4-8.9-.6-7.2-1.9-14.3-3.8-21.3"/>
  <path d="M65.5 58.6l5.2-1.2M96.2 57.6l5.4 1.6"/>
  <!-- torso, a little crooked -->
  <path d="M74.4 87.6c5.4-1.4 10.6-1.3 15.6.2-.2 5.9-.9 11.6-2.3 17.1-3.8.8-7.6.7-11.4-.3-.9-5.7-1.5-11.3-1.9-17Z"/>
  <!-- legs: left knee on the ground, right foot planted -->
  <path d="M76.4 104.8c-4.4 2.9-9.4 4.6-14.8 4.9l-4.4 6.6"/>
  <path d="M87.6 105c4.8-.9 9 .7 11.4 4.2.6 2.3.7 4.6.4 7"/>
  <!-- ground -->
  <path d="M24 116.8c20.3-.9 40.7-.8 61-.3 20.8.5 41.6.5 62.4-.6"/>
  <path d="M138.6 120.2c4.2-.3 8.4-.4 12.6-.4"/>
</svg>
