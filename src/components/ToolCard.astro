---
import { u } from '~/lib/url';
import CardActions from './CardActions.astro';
import { Image } from 'astro:assets';
import { shotFor } from '~/lib/shots';
import { domainOf, getTools, type Tool } from '~/lib/data';
import { newIds, newUntil } from '~/lib/related';
import popular from '~/data/popular.json';
import { loc, useTranslations, defaultLang, type Lang } from '~/i18n';
import { AUTHOR, SITE } from '~/site.config';

interface Props {
  tool: Tool;
  categoryName: string;
  lang?: Lang;
  /** first row of the grid loads eagerly */
  eager?: boolean;
  /** hide the category label, e.g. on a category page */
  hideCategory?: boolean;
  /** one grey line under the summary, e.g. "Place 1 · 120 views" on Popular */
  rank?: string;
  /** leave the save / "⋯" buttons out of the HTML: the page builds them from one
      shared template (Gallery.astro) for the cards it shows. Keeps the home page light. */
  lazyActions?: boolean;
}

const { tool, categoryName, lang = defaultLang, eager = false, hideCategory = false, rank, lazyActions = false } = Astro.props;
const shot = shotFor(tool.id);
const d = tool.data;
const t = useTranslations(lang);
const isNew = newIds(await getTools()).has(tool.id);
// same outbound link as the tool page: a partner link as is, a normal one with ?ref=
const outbound = new URL(d.affiliateUrl ?? d.url);
if (!d.affiliateUrl) outbound.searchParams.set('ref', SITE.ref);
const views = ((popular.views ?? {}) as Record<string, number>)[tool.id] ?? 0;
const badge = d.openSource ? t('pricing.openSource') : t(`pricing.${d.pricing}`);
---
<div
  class="card-wrap"
  data-card
  data-id={tool.id}
  data-added={d.added.toISOString().slice(0, 10)}
  data-own={d.own ? '' : undefined}
  data-name={d.name.toLowerCase()}
  data-category={d.category}
  data-pricing={d.openSource && d.pricing === 'free' ? 'free' : d.pricing}
  data-open={d.openSource ? '' : undefined}
  data-views={views}
  data-featured={d.featured ? '' : undefined}
  data-title={lazyActions ? d.name : undefined}
  data-url={lazyActions ? d.url : undefined}
  data-out={lazyActions ? outbound.href : undefined}
  data-rel={lazyActions ? (d.affiliateUrl ? 'sponsored noopener' : 'noopener') : undefined}
  data-lazy-actions={lazyActions ? '' : undefined}
>
<a class="card" href={u(`/tool/${tool.id}`, lang)}>
  <div class="card__media">
    {shot ? (
      <Image
        class="card__shot"
        src={shot}
        alt=""
        widths={[480, 720, 960]}
        sizes="(min-width: 64rem) 32vw, (min-width: 40rem) 48vw, 92vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        format="webp"
        quality={78}
      />
    ) : (
      <div class="shot-fallback" aria-hidden="true">{domainOf(d.url)}</div>
    )}
    <span class="card__badge card__badge--price">{badge}</span>
    {/* "New" and "Viewed" share the left corner. The script in Base.astro
        shows "Viewed" for sites opened before (and then hides "New"), and
        drops "New" once its date has passed, even if the site wasn't rebuilt. */}
    {isNew && <span class="card__badge card__badge--new" data-new-until={newUntil(tool)}>{t('card.new')}</span>}
    <span class="card__badge card__badge--seen" data-seen-badge hidden>{t('card.seen')}</span>
  </div>
  <div class="card__caption">
    <div class="card__row">
      <span class="card__name">{d.name}</span>
      {d.affiliateUrl && <span class="card__partner" title={t('tool.partner')}>{t('card.partner')}</span>}
      {d.own && <span class="card__partner card__own">{t('card.own')}</span>}
      {!hideCategory && <span class="card__category">{categoryName}</span>}
    </div>
    <p class="card__summary">{loc(d.summary, lang)}</p>
    {d.note && (
      <p class="card__note"><span class="visually-hidden">{t('card.note', { name: AUTHOR.name })}: </span>{loc(d.note, lang)}</p>
    )}
    {rank && <p class="card__rank t-tabular">{rank}</p>}
  </div>
</a>
{!lazyActions && <CardActions name={d.name} id={tool.id} url={d.url} out={outbound.href} rel={d.affiliateUrl ? 'sponsored noopener' : 'noopener'} lang={lang} />}
</div>
