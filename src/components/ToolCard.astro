---
import { u } from '~/lib/url';
import { Image } from 'astro:assets';
import { shotFor } from '~/lib/shots';
import { domainOf, getTools, type Tool } from '~/lib/data';
import { newIds, newUntil } from '~/lib/related';
import { loc, useTranslations, defaultLang, type Lang } from '~/i18n';

interface Props {
  tool: Tool;
  categoryName: string;
  lang?: Lang;
  /** first row of the grid loads eagerly */
  eager?: boolean;
  /** hide the category label, e.g. on a category page */
  hideCategory?: boolean;
}

const { tool, categoryName, lang = defaultLang, eager = false, hideCategory = false } = Astro.props;
const shot = shotFor(tool.id);
const d = tool.data;
const t = useTranslations(lang);
const isNew = newIds(await getTools()).has(tool.id);
const badge = d.openSource ? t('pricing.openSource') : t(`pricing.${d.pricing}`);
---
<a
  class="card"
  href={u(`/tool/${tool.id}`, lang)}
  data-card
  data-id={tool.id}
  data-own={d.own ? '' : undefined}
  data-name={d.name.toLowerCase()}
>
  <div class="card__media">
    {shot ? (
      <Image
        class="card__shot"
        src={shot}
        alt=""
        widths={[480, 720, 960]}
        sizes="(min-width: 64rem) 32vw, (min-width: 40rem) 48vw, 92vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        format="webp"
        quality={78}
      />
    ) : (
      <div class="shot-fallback" aria-hidden="true">{domainOf(d.url)}</div>
    )}
    <span class="card__badge">{badge}</span>
    {/* "New" and "Viewed" share the left corner. The script in Base.astro
        shows "Viewed" for sites opened before (and then hides "New"), and
        drops "New" once its date has passed, even if the site wasn't rebuilt. */}
    {isNew && <span class="card__badge card__badge--new" data-new-until={newUntil(tool)}>{t('card.new')}</span>}
    <span class="card__badge card__badge--seen" data-seen-badge hidden>{t('card.seen')}</span>
  </div>
  <div class="card__caption">
    <div class="card__row">
      <span class="card__name">{d.name}</span>
      {!hideCategory && <span class="card__category">{categoryName}</span>}
    </div>
    <p class="card__summary">{loc(d.summary, lang)}</p>
  </div>
</a>
