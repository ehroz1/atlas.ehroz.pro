---
/**
 * Comments under a site's page. Signed-in visitors write; everything goes
 * through moderation in /admin/ without telling anyone: the author sees
 * their own comment right away (row security returns it to them), others
 * see it only once it's approved. Nothing is rendered without the backend.
 */
import { u } from '~/lib/url';
import { BACKEND } from '~/lib/backend';
import { useTranslations, type Lang } from '~/i18n';

interface Props {
  /** comment thread: a tool id, or "blog-<slug>" for an article (the table's tool_id column) */
  toolId: string;
  lang: Lang;
  /** page to come back to after signing in, language-free, e.g. "blog/my-article/" */
  next?: string;
}
const { toolId, lang, next = `tool/${toolId}/` } = Astro.props;
const t = useTranslations(lang);
const msg = {
  failed: t('comments.failed'),
  tooMany: t('comments.tooMany'),
  del: t('comments.delete'),
  empty: t('comments.empty'),
};
---
{BACKEND.enabled && (
  <section class="comments section--more"
    aria-labelledby="comments-h" data-comments={toolId} data-lang={lang} data-msg={JSON.stringify(msg)}>
    <div class="section-head">
      <h2 class="t-title" id="comments-h">{t('comments.title')} <span class="t-muted t-tabular" data-comments-count></span></h2>
    </div>
    <ol class="comments__list" data-comments-list></ol>

    <form class="comments__form" data-comments-form hidden>
      <label class="visually-hidden" for="comment-body">{t('comments.placeholder')}</label>
      <textarea class="textarea" id="comment-body" name="body" maxlength="2000" required placeholder={t('comments.placeholder')}></textarea>
      <div class="cluster" style="--gap: var(--s-3)">
        <button class="btn btn--solid" type="submit">{t('comments.send')}</button>
        <span class="t-meta" data-comments-as></span>
        <span class="t-meta" data-comments-status aria-live="polite"></span>
      </div>
    </form>
    <div class="comments__login" data-comments-login hidden>
      <a class="btn" href={u('/account', lang) + `?next=${next}`}>{t('comments.signIn')}</a>
    </div>
  </section>
)}

<script>
  import { enabled, sb, maybeSignedIn, getProfile } from '~/scripts/backend';

  const box = document.querySelector<HTMLElement>('[data-comments]');
  if (enabled && box) {
    const toolId = box.dataset.comments!;
    const lang = box.dataset.lang!;
    const msg = JSON.parse(box.dataset.msg!);
    const list = box.querySelector<HTMLElement>('[data-comments-list]')!;
    const form = box.querySelector<HTMLFormElement>('[data-comments-form]')!;
    const status = box.querySelector<HTMLElement>('[data-comments-status]')!;
    const fmt = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', year: 'numeric' });
    let me: string | null = null;

    type C = { id: string; author_name: string; body: string; created_at: string; user_id: string };
    const render = (items: C[]) => {
      box.querySelector('[data-comments-count]')!.textContent = items.length ? String(items.length) : '';
      if (!items.length) {
        const li = document.createElement('li');
        li.className = 't-meta';
        li.textContent = msg.empty;
        list.replaceChildren(li);
        return;
      }
      list.replaceChildren(...items.map((c) => {
        const li = document.createElement('li');
        li.className = 'comment';
        const head = document.createElement('p');
        head.className = 'comment__head';
        const name = document.createElement('span');
        name.className = 't-medium';
        name.textContent = c.author_name;
        const date = document.createElement('time');
        date.className = 't-meta';
        date.dateTime = c.created_at;
        date.textContent = ' · ' + fmt.format(new Date(c.created_at));
        head.append(name, date);
        const body = document.createElement('p');
        body.className = 'comment__body';
        body.textContent = c.body;
        li.append(head, body);
        if (me && c.user_id === me) {
          const del = document.createElement('button');
          del.className = 'link t-meta';
          del.type = 'button';
          del.textContent = msg.del;
          del.addEventListener('click', async () => {
            await (await sb()).from('comments').delete().eq('id', c.id);
            load();
          });
          li.append(del);
        }
        return li;
      }));
    };

    // the rows policy decides what comes back: approved + this user's own
    const load = async () => {
      const { data } = await (await sb())
        .from('comments')
        .select('id,author_name,body,created_at,user_id')
        .eq('tool_id', toolId)
        .order('created_at', { ascending: true })
        .limit(200);
      render((data as C[]) ?? []);
    };

    const init = async () => {
      const profile = maybeSignedIn() ? await getProfile().catch(() => null) : null;
      me = profile?.id ?? null;
      if (profile) {
        form.hidden = false;
        box.querySelector('[data-comments-as]')!.textContent = (profile as any).display_name || profile.email?.split('@')[0] || '';
      } else {
        box.querySelector<HTMLElement>('[data-comments-login]')!.hidden = false;
      }
      await load();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = String(new FormData(form).get('body') ?? '').trim();
      if (!text) return;
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      status.textContent = '';
      const { error } = await (await sb()).from('comments').insert({ tool_id: toolId, body: text });
      btn.disabled = false;
      if (error) {
        status.textContent = /too many/.test(error.message) ? msg.tooMany : msg.failed;
        return;
      }
      form.reset();
      load();
    });

    // load when the section comes near the screen
    const io = new IntersectionObserver((entries) => {
      if (entries.some((x) => x.isIntersecting)) {
        io.disconnect();
        init().catch(() => {});
      }
    }, { rootMargin: '400px' });
    io.observe(box);
  }
</script>
