---
/**
 * Toolbar (category chips + count) and the card grid, with client-side
 * search. Works without JavaScript: the grid is plain HTML and chips are
 * links. The script only hides cards that don't match the search box.
 */
import ToolCard from './ToolCard.astro';
import CategoryChips from './CategoryChips.astro';
import type { Tool, Category } from '~/lib/data';
import { loc, useTranslations, plural, defaultLang, type Lang } from '~/i18n';

interface Props {
  tools: Tool[];
  categories: Category[];
  current?: string;
  lang?: Lang;
  /** show the category chips above the grid (off on home: the search panel has them) */
  filters?: boolean;
}
const { tools, categories, current, lang = defaultLang, filters = true } = Astro.props;
const t = useTranslations(lang);
const names = new Map(categories.map((c) => [c.id, loc(c.data.name, lang)]));
const countText = (n: number) => t(`results.count.${plural(lang, n)}`, { count: n });
---
<section id="sites" aria-label="Sites" data-scope-category={current}>
  <div class={filters ? 'toolbar' : 'visually-hidden'}>
    {filters && <CategoryChips categories={categories} current={current} lang={lang} />}
    <span class="toolbar__count t-tabular" data-count aria-live="polite"
      data-one={t('results.count.one')} data-other={t('results.count.other')}>
      {countText(tools.length)}
    </span>
  </div>

  <div class="cards" data-cards>
    {tools.map((tool) => (
      <ToolCard tool={tool} categoryName={names.get(tool.data.category)!} lang={lang} hideCategory={!!current} />
    ))}
  </div>
  {/* Shuffle the cards for every visit. Inline and synchronous, so it runs
      before the first paint and nobody sees the original order flash by.
      (All card images are lazy: whichever cards land on top load first.) */}
  <script is:inline>
    (function () {
      var grid = document.currentScript.previousElementSibling;
      var cards = Array.prototype.slice.call(grid.children);
      for (var i = cards.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = cards[i]; cards[i] = cards[j]; cards[j] = tmp;
      }
      cards.forEach(function (c) { grid.appendChild(c); });
    })();
  </script>

  <div class="empty" data-empty hidden>
    <p class="empty__title">{t('results.empty.title')}</p>
    <p>{t('results.empty.body')}</p>
    <button class="btn btn--sm mt-2" type="button" data-search-reset>{t('results.empty.reset')}</button>
  </div>
</section>

<script>
  /* Shows only the cards the finder says match. Header.astro fires
     `atlas:filter` with { ids, q } and keeps the last one on window,
     in case it ran before this script. Cards whose name starts with the
     query move to the front. */
  const grid = document.querySelector<HTMLElement>('[data-cards]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const count = document.querySelector<HTMLElement>('[data-count]');

  if (grid) {
    const original = Array.from(grid.querySelectorAll<HTMLElement>('[data-card]'));
    const normalize = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').trim();

    const apply = ({ ids, q }: { ids: Set<string>; q: string }) => {
      const nq = normalize(q);
      const lead: HTMLElement[] = [];
      const rest: HTMLElement[] = [];
      for (const card of original) {
        const match = ids.has(card.dataset.id!);
        card.hidden = !match;
        if (match) (nq && card.dataset.name?.startsWith(nq) ? lead : rest).push(card);
      }
      grid.append(...lead, ...rest, ...original.filter((c) => c.hidden));
      const shown = lead.length + rest.length;
      if (count) {
        const tpl = shown === 1 ? count.dataset.one : count.dataset.other;
        count.textContent = (tpl ?? '{count}').replace('{count}', String(shown));
      }
      if (empty) {
        empty.hidden = shown > 0;
        grid.hidden = shown === 0;
      }
    };

    const last = (window as any).__atlasFilter;
    if (last) apply(last);
    document.addEventListener('atlas:filter', (e) => apply((e as CustomEvent).detail));
    document.querySelector('[data-search-reset]')?.addEventListener('click', () => {
      document.dispatchEvent(new Event('atlas:reset'));
    });
  }
</script>
