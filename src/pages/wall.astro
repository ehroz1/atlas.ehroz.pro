---
/**
 * Wall: every screenshot on one endless plane you can move in any
 * direction — wheel/trackpad, drag with the mouse, swipe, arrow keys.
 *
 * The server renders one block of ROWS × COLS tiles (brick-offset rows).
 * The script tiles that block 3 × 3 and, whenever the view drifts out of
 * the middle copy, jumps back by exactly one block, so it never ends.
 */
import { u } from '~/lib/url';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import { getTools } from '~/lib/data';
import { shotFor } from '~/lib/shots';

const tools = (await getTools()).filter((x) => shotFor(x.id));
const COLS = 8;
const ROWS = 8; // keep even so the brick offset repeats cleanly
// Step through the list with a row offset so neighbours vary between rows.
const pick = (r: number, c: number) => tools[(r * COLS + c + r * 3) % tools.length];
const seen = new Set<string>();
---
<Base title="Wall" description="Every site in Atlas on one endless wall of screenshots." flush bare>
  <h1 class="visually-hidden">All sites</h1>
  <div class="wall" tabindex="0" aria-label="Wall of sites. Scroll, drag or use the arrow keys to move." data-wall data-cols={COLS} data-rows={ROWS}>
    <div class="wall__plane" data-wall-plane>
      {Array.from({ length: ROWS }, (_, r) => (
        <div class="wall__row">
          {Array.from({ length: COLS }, (_, c) => {
            const tool = pick(r, c);
            const first = !seen.has(tool.id);
            seen.add(tool.id);
            return (
              <a class="wall__item" href={u(`/tool/${tool.id}`)} draggable="false"
                aria-label={first ? tool.data.name : undefined}
                aria-hidden={first ? undefined : 'true'}
                tabindex={first ? undefined : -1}>
                <Image src={shotFor(tool.id)!} alt="" draggable="false" widths={[480, 720]} sizes="(min-width: 48rem) 21vw, 45vw" format="webp" quality={74} loading={r < 4 ? 'eager' : 'lazy'} />
                <span class="wall__label">{tool.data.name}</span>
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </div>
  <p class="wall__hint" data-wall-hint>Scroll or drag to explore</p>
</Base>

<script>
  const wall = document.querySelector<HTMLElement>('[data-wall]')!;
  const plane = document.querySelector<HTMLElement>('[data-wall-plane]')!;
  const hint = document.querySelector<HTMLElement>('[data-wall-hint]');
  const COLS = Number(wall.dataset.cols);
  const ROWS = Number(wall.dataset.rows);

  // 1. Tile the block 3 × 3: triple every row, then triple the rows.
  const baseRows = Array.from(plane.children) as HTMLElement[];
  const hide = (el: HTMLElement) => {
    el.querySelectorAll('a').forEach((a) => {
      a.setAttribute('aria-hidden', 'true');
      a.tabIndex = -1;
      a.removeAttribute('aria-label');
    });
    return el;
  };
  for (const row of baseRows) {
    const items = Array.from(row.children);
    for (let k = 0; k < 2; k++) items.forEach((it) => row.append(hide(it.cloneNode(true) as HTMLElement)));
  }
  const before = baseRows.map((r) => hide(r.cloneNode(true) as HTMLElement));
  const after = baseRows.map((r) => hide(r.cloneNode(true) as HTMLElement));
  plane.prepend(...before);
  plane.append(...after);

  // 2. Measure one block and start in the middle copy.
  let blockW = 0;
  let blockH = 0;
  const measure = () => {
    const rows = plane.children as HTMLCollectionOf<HTMLElement>;
    const first = rows[0].children as HTMLCollectionOf<HTMLElement>;
    blockW = first[COLS].offsetLeft - first[0].offsetLeft;
    blockH = rows[ROWS].offsetTop - rows[0].offsetTop;
  };
  measure();
  wall.scrollLeft = blockW + blockW / 2 - wall.clientWidth / 2;
  wall.scrollTop = blockH + blockH / 2 - wall.clientHeight / 2;

  // 3. Wrap around so it never ends.
  const wrap = () => {
    if (wall.scrollLeft < blockW * 0.5) wall.scrollLeft += blockW;
    else if (wall.scrollLeft > blockW * 1.5) wall.scrollLeft -= blockW;
    if (wall.scrollTop < blockH * 0.5) wall.scrollTop += blockH;
    else if (wall.scrollTop > blockH * 1.5) wall.scrollTop -= blockH;
  };
  let moved = false;
  wall.addEventListener('scroll', () => {
    wrap();
    if (!moved && hint) {
      moved = true;
      hint.classList.add('is-hidden');
    }
  }, { passive: true });
  addEventListener('resize', () => {
    const fx = (wall.scrollLeft % blockW) / blockW;
    const fy = (wall.scrollTop % blockH) / blockH;
    measure();
    wall.scrollLeft = blockW + fx * blockW;
    wall.scrollTop = blockH + fy * blockH;
  });

  // 4. Drag to pan with the mouse (touch already pans natively).
  let drag: { x: number; y: number; left: number; top: number; active: boolean } | null = null;
  let suppressClick = false;
  wall.addEventListener('pointerdown', (e) => {
    if (e.pointerType !== 'mouse' || e.button !== 0) return;
    drag = { x: e.clientX, y: e.clientY, left: wall.scrollLeft, top: wall.scrollTop, active: false };
  });
  addEventListener('pointermove', (e) => {
    if (!drag) return;
    const dx = e.clientX - drag.x;
    const dy = e.clientY - drag.y;
    if (!drag.active && Math.hypot(dx, dy) > 4) {
      drag.active = true;
      wall.classList.add('is-dragging');
    }
    if (drag.active) {
      wall.scrollLeft = drag.left - dx;
      wall.scrollTop = drag.top - dy;
      // keep the anchor valid after a wrap jump
      drag.left = wall.scrollLeft + dx;
      drag.top = wall.scrollTop + dy;
    }
  });
  addEventListener('pointerup', () => {
    if (drag?.active) suppressClick = true;
    drag = null;
    wall.classList.remove('is-dragging');
  });
  // a drag that ends on a tile shouldn't open it
  wall.addEventListener('click', (e) => {
    if (suppressClick) {
      e.preventDefault();
      e.stopPropagation();
      suppressClick = false;
    }
  }, true);

  // 5. Arrow keys / space work on the focused scroller.
  wall.focus({ preventScroll: true });
</script>
