---
import Base from '~/layouts/Base.astro';
import HeroCollage from '~/components/HeroCollage.astro';
import Gallery from '~/components/Gallery.astro';
import { getTools, getCategories } from '~/lib/data';

const [tools, categories] = await Promise.all([getTools(), getCategories()]);
---
<Base>
  <div class="container container--wide">
    <HeroCollage tools={tools} categoryCount={categories.length} />
    <div style="padding-top: var(--grid-gap)">
      <Gallery tools={tools} categories={categories} filters={false} />
    </div>
  </div>
</Base>
