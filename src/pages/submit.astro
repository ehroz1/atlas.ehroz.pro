---
import { u } from '~/lib/url';
import Base from '~/layouts/Base.astro';
import { getCategories } from '~/lib/data';
import { loc } from '~/i18n';

const categories = await getCategories();
/* Submissions open the visitor's mail app with a prefilled letter.
   Set PUBLIC_SUBMIT_EMAIL in .env to the receiving address. */
const email = (import.meta.env.PUBLIC_SUBMIT_EMAIL as string | undefined) ?? 'admin@picta.cc';
---
<Base title="Submit a site" description="Suggest a website or tool for Atlas.">
  <div class="container container--narrow">
    <div class="section" style="padding-bottom: 0">
      <div class="stack" style="--gap: var(--s-3)">
        <h1 class="t-statement">Submit a site</h1>
        <p class="t-secondary">
          Tell us what it is and why it's good. We read everything and add the ones that
          fit <a class="link" href={u('/about')}>the criteria</a>. Skip the marketing copy, one honest
          sentence is better.
        </p>
      </div>

      <form class="form mt-12" data-submit-form data-email={email}>
        <div class="field">
          <label class="field__label" for="url">Link</label>
          <input class="input" id="url" name="url" type="url" placeholder="https://" required inputmode="url" />
        </div>

        <div class="field">
          <label class="field__label" for="name">Name</label>
          <input class="input" id="name" name="name" type="text" placeholder="What is it called?" required />
        </div>

        <div class="field">
          <label class="field__label" for="category">Category</label>
          <select class="select" id="category" name="category">
            {categories.map((c) => <option value={c.id}>{loc(c.data.name)}</option>)}
            <option value="other">Not sure</option>
          </select>
        </div>

        <div class="field">
          <label class="field__label" for="why">Why is it useful?</label>
          <textarea class="textarea" id="why" name="why" placeholder="I use it for…" required></textarea>
          <span class="field__hint">A sentence or two is plenty.</span>
        </div>

        <div class="field">
          <label class="field__label" for="email">Your email <span class="t-muted" style="font-weight: 400">(optional)</span></label>
          <input class="input" id="email" name="email" type="email" placeholder="So we can say thanks" autocomplete="email" />
        </div>

        <div class="field">
          <label class="field__label" for="photos">Photos <span class="t-muted" style="font-weight: 400">(optional)</span></label>
          <input class="input" id="photos" name="photos" type="file" accept="image/*" multiple />
          <span class="field__hint">On phones they attach automatically. On a computer, attach them in the email that opens.</span>
        </div>

        <label class="cluster t-small t-secondary" style="--gap: var(--s-2)">
          <input class="checkbox" type="checkbox" name="maker" value="yes" />
          I made this
        </label>

        <div class="cluster" style="--gap: var(--s-4)">
          <button class="btn btn--solid btn--lg" type="submit">Send</button>
          <span class="t-meta" data-submit-status aria-live="polite"></span>
        </div>
      </form>
    </div>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-submit-form]');
  const status = document.querySelector<HTMLElement>('[data-submit-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    const d = new FormData(form);
    const g = (k: string) => String(d.get(k) ?? '').trim();
    const body = [
      `Link: ${g('url')}`,
      `Name: ${g('name')}`,
      `Category: ${form.querySelector<HTMLSelectElement>('#category')?.selectedOptions[0]?.text ?? ''}`,
      '',
      g('why'),
      '',
      g('email') ? `From: ${g('email')}` : '',
      d.get('maker') ? 'I made this.' : '',
    ].filter((l, i, a) => l || (i && a[i - 1])).join('\n');
    const subject = `Atlas submission: ${g('name')}`;
    const files = (d.getAll('photos') as File[]).filter((f) => f.size > 0);

    // Phones: the share sheet can carry real attachments into the mail app.
    if (files.length && navigator.canShare?.({ files })) {
      try {
        await navigator.share({ files, title: subject, text: `${subject}\n\n${body}` });
        status.textContent = 'Thanks, got it.';
        return;
      } catch (err) {
        if ((err as Error).name === 'AbortError') return;
      }
    }
    location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    status.textContent = files.length
      ? 'Mail app opened. Attach your photos to the email and send.'
      : 'Mail app opened. Just hit send.';
  });
</script>
