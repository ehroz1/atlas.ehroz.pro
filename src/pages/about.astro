---
import Base from '~/layouts/Base.astro';
import { getTools, getCategories } from '~/lib/data';
import { loc } from '~/i18n';

const [tools, categories] = await Promise.all([getTools(), getCategories()]);
const counts = new Map<string, number>();
for (const tool of tools) counts.set(tool.data.category, (counts.get(tool.data.category) ?? 0) + 1);
---
<Base title="About" description="What Atlas is, how sites get in, and what we leave out.">
  <div class="container">
    <div class="section" style="padding-bottom: 0">
      <div class="prose">
        <h1 class="t-statement">About Atlas</h1>
        <p>
          Atlas is a list of websites and tools we keep coming back to. The kind you bookmark,
          forget the name of, and then spend ten minutes trying to find again. It started as a
          personal notes file and grew into something worth sharing.
        </p>
        <p>
          It is for people who make things: designers, developers, video and audio people,
          writers, and anyone who likes a well-built tool.
        </p>

        <h2>How a site gets in</h2>
        <p>Every entry is opened, used for a while and written up by hand. We look for three things:</p>
        <ul>
          <li>It does one job clearly better than the obvious alternative.</li>
          <li>You can understand what it does within a minute of landing on it.</li>
          <li>It respects your time: no dark patterns, no forced sign-up just to look around.</li>
        </ul>

        <h2>What we leave out</h2>
        <p>
          Paid placements, affiliate rankings and “top 100 AI tools” lists. If a tool is on
          Atlas, it is because someone here found it useful, not because it paid to be here.
          Outbound links carry a plain <code>ref</code> tag so sites know where visitors came from;
          that's all.
        </p>

        <h2>What's inside</h2>
        <p>{tools.length} sites so far, in {categories.length} categories:</p>
        <ul>
          {categories.map((c) => (
            <li><a href={`/category/${c.id}`}>{loc(c.data.name)}</a> <span class="t-muted">{counts.get(c.id) ?? 0}</span></li>
          ))}
        </ul>

        <h2>Suggest something</h2>
        <p>
          Found a site that belongs here? <a href="/submit">Send it over</a>. Made it yourself?
          Send it anyway, just say so.
        </p>
      </div>
    </div>
  </div>
</Base>
