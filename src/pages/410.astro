---
/* 410 Gone page (/410.html) for permanently removed resources.
   noindex, no canonical; navigation to main sections in both languages. */
import { u } from '~/lib/url';
import Base from '~/layouts/Base.astro';
import HeroDrawing from '~/components/HeroDrawing.astro';
import { useTranslations, defaultLang, langs } from '~/i18n';
const t = useTranslations(defaultLang);
const copy = {
  en: {
    metaTitle: 'Page permanently removed (410)',
    title: 'This page was permanently removed',
    body: 'The site or material that used to live at this address has been removed from the index. Browse the current catalog below:',
  },
  ru: {
    metaTitle: 'Страница удалена окончательно (410)',
    title: 'Эта страница удалена окончательно',
    body: 'Сайт или материал, который был по этому адресу, убран из каталога. Посмотрите актуальные разделы:',
  },
} as const;
const blocks = langs.map((lang) => {
  const tl = useTranslations(lang);
  return {
    lang,
    title: copy[lang].title,
    body: copy[lang].body,
    links: [
      ['/', tl('notFound.home')],
      ['/categories', tl('nav.categories')],
      ['/popular', tl('nav.popular')],
      ['/blog', tl('nav.blog')],
      ['/about', tl('nav.about')],
      ['/contact', tl('nav.contact')],
    ] as const,
  };
});
---
<Base title={copy[defaultLang].metaTitle} description={copy[defaultLang].body} noindex>
  <div class="container">
    <div class="empty empty--page">
      <HeroDrawing class="hero__drawing" />
      {blocks.map((b, i) => (
        <div lang={b.lang} class={i ? 'mt-12' : ''}>
          {i === 0 ? <h1 class="t-statement">{b.title}</h1> : <h2 class="t-title">{b.title}</h2>}
          <p class="mt-2">{b.body}</p>
          <ul class="chips chips--center mt-4" role="list">
            {b.links.map(([path, label]) => <li><a class="chip" href={u(path, b.lang)}>{label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</Base>
