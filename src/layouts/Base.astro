---
/**
 * Every page goes through here. A page passes its entry from
 * src/lib/routes.ts and gets: title, description, canonical, hreflang,
 * Open Graph / Twitter, one schema.org @graph, breadcrumbs, robots rules
 * (noindex off production), verification tags and analytics.
 */
import { u, splitPath, isAliasPath } from '~/lib/url';
import LangDetect from '~/components/LangDetect.astro';
import '~/styles/atlas.css';
import sansFont from '~/assets/fonts/MedeoSansVariable.woff2?url';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Analytics from '~/components/Analytics.astro';
import Counter from '~/components/Counter.astro';
import { useTranslations, defaultLang, langs, type Lang } from '~/i18n';
import { absUrl, fitTitle, fitDescription } from '~/lib/seo';
import { IS_PROD } from '~/lib/env';
import { SEARCH_VERIFICATION } from '~/analytics.config';
import { SITE } from '~/site.config';
import type { PageEntry } from '~/lib/routes';
import * as schema from '~/lib/schema';

interface Props {
  lang?: Lang;
  /** the page's entry from routes.ts; absent only on 404 */
  entry?: PageEntry;
  /** used when there's no entry (404) */
  title?: string;
  description?: string;
  /** visible breadcrumbs, the last item is the current page */
  crumbs?: { name: string; path: string }[];
  /** container class for the breadcrumbs, to line up with the page */
  crumbsContainer?: string;
  /** extra schema.org nodes (ItemList, SoftwareApplication…) */
  nodes?: Record<string, unknown>[];
  /** extra fields on the WebPage node (mainEntity, about…) */
  pageExtra?: Record<string, unknown>;
  noindex?: boolean;
  /** content starts under the floating bar instead of below it (Wall) */
  flush?: boolean;
  /** hide the footer (pages that are a single full-bleed view) */
  bare?: boolean;
  /** footer with link columns over the mountains (home page) */
  scenicFooter?: boolean;
  /** on a site's own page: its id, remembered as "viewed" */
  toolId?: string;
}

const { lang = defaultLang, entry, crumbs, crumbsContainer = 'container', nodes = [], pageExtra, flush = false, bare = false, scenicFooter = false, toolId } = Astro.props;
const noindex = Astro.props.noindex || !entry;
const t = useTranslations(lang);

const title = entry ? entry.title[lang] : fitTitle(`${Astro.props.title} · ${SITE.name}`);
const description = entry ? entry.description[lang] : fitDescription(Astro.props.description ?? t('site.description'));
// /en/… (alias of a root page): same content, canonical points to the root URL
const alias = isAliasPath(Astro.url.pathname);
const canonical = entry ? absUrl(entry.path, lang) : undefined;
const alternates = entry ? langs.map((l) => ({ lang: l, href: absUrl(entry.path, l) })) : [];
const ogImage = absUrl(`/${entry ? entry.og[lang] : `og/${lang}/home`}.png`, defaultLang);
const updated = entry?.updated.toISOString();
const robots = !IS_PROD || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ogLocale = t('site.locale');
const otherLocales = langs.filter((l) => l !== lang).map((l) => useTranslations(l)('site.locale'));

// language switch target: the same page in the other language
const other = langs.find((l) => l !== lang)!;
const here = splitPath(Astro.url.pathname).path;
const switchHref = entry ? u(entry.path, other) : u('/', other);

// breadcrumbs: home first
const crumbItems: schema.Crumb[] | undefined = crumbs && [
  { name: SITE.name, url: absUrl('/', lang), href: u('/', lang) },
  ...crumbs.map((c) => ({ name: c.name, url: absUrl(c.path, lang), href: u(c.path, lang) })),
];

const ogType = entry?.kind === 'article' || entry?.kind === 'tool' ? 'article' : entry?.kind === 'author' ? 'profile' : 'website';
const published = entry?.article ? entry.article.published.toISOString() : entry?.tool ? entry.tool.data.added.toISOString() : undefined;

const jsonLd =
  entry &&
  schema.graph([
    schema.website(),
    schema.organization(lang),
    schema.person(lang),
    schema.webPage(entry, lang, canonical!, ogImage, !!crumbItems, pageExtra),
    schema.imageObject(canonical!, ogImage, entry.title[lang]),
    ...(crumbItems ? [schema.breadcrumbs(canonical!, crumbItems)] : []),
    ...nodes,
  ]);
---
<!doctype html>
<html lang={lang} data-path={here}>
  <head>
    <meta charset="utf-8" />
    {entry && <LangDetect alias={alias} redirect={lang === defaultLang && !alias} base={import.meta.env.BASE_URL.replace(/\/$/, '')} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {entry && <link rel="alternate" hreflang="x-default" href={absUrl(entry.path, defaultLang)} />}
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={u('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    {/* Skeleton for screenshots: while an <img> is loading it shows a moving
        grey shimmer (CSS: "Skeleton" in atlas.css). This marks every image
        that finished (or failed) with .is-loaded, which stops the shimmer.
        Runs in <head>, before any <img> exists, so no load event is missed;
        `load` doesn't bubble, hence the capture listener. Without JavaScript
        there is no .skel class and no shimmer, just the plain grey box.
        Also applies the user's saved motion preference (`atlas:motion`). */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('skel');
        try { if (localStorage.getItem('atlas:motion') === 'off') d.classList.add('no-motion'); } catch (e) {}
        var done = function (e) { var t = e.target; if (t && t.tagName === 'IMG') t.classList.add('is-loaded'); };
        document.addEventListener('load', done, true);
        document.addEventListener('error', done, true);
      })();
    </script>
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ogLocale} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {updated && <meta property="og:updated_time" content={updated} />}
    {ogType === 'article' && published && <meta property="article:published_time" content={published} />}
    {ogType === 'article' && updated && <meta property="article:modified_time" content={updated} />}
    {entry?.article && <meta property="article:author" content={absUrl('/author/ehroz/', lang)} />}
    {entry?.article?.categories.map((c) => <meta property="article:section" content={c} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    {IS_PROD && SEARCH_VERIFICATION.google && <meta name="google-site-verification" content={SEARCH_VERIFICATION.google} />}
    {IS_PROD && SEARCH_VERIFICATION.yandex && <meta name="yandex-verification" content={SEARCH_VERIFICATION.yandex} />}
    {IS_PROD && SEARCH_VERIFICATION.bing && <meta name="msvalidate.01" content={SEARCH_VERIFICATION.bing} />}
    <link rel="sitemap" type="application/xml" href={u('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={t('rss.title')} href={u('/rss.xml')} />
    {(entry?.kind === 'blog' || entry?.kind === 'article' || entry?.kind === 'author') && (
      <link rel="alternate" type="application/rss+xml" title={`${t('blog.rss')} · ${SITE.name}`} href={u('/blog/rss.xml', lang)} />
    )}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <slot name="head" />
  </head>
  <body data-tool={toolId}>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} switchHref={switchHref} />
    <main id="main" class:list={{ 'main--flush': flush }}>
      {crumbItems && (
        <div class={crumbsContainer}>
          <Breadcrumbs items={crumbItems} label={t('nav.breadcrumbs')} />
        </div>
      )}
      <slot />
    </main>
    {!bare && <Footer lang={lang} switchHref={switchHref} scenic={scenicFooter} />}
    {/* "Viewed" and "New", per browser. Inline at the end of the body so the
        marks are there on first paint. localStorage key: atlas:seen = [ids],
        most recent first. Without storage nothing is marked. */}
    <script is:inline>
      (function () {
        var KEY = 'atlas:seen', seen = [];
        try { seen = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
        if (!Array.isArray(seen)) seen = [];
        var marked = new Set(seen);
        var here = document.body.getAttribute('data-tool');
        if (here) {
          seen = [here].concat(seen.filter(function (id) { return id !== here; })).slice(0, 500);
          try { localStorage.setItem(KEY, JSON.stringify(seen)); } catch (e) {}
        }
        var today = new Date().toISOString().slice(0, 10);
        document.querySelectorAll('[data-card]').forEach(function (card) {
          if (marked.has(card.getAttribute('data-id'))) {
            card.classList.add('is-seen');
            var b = card.querySelector('[data-seen-badge]');
            if (b) b.hidden = false;
          }
          var n = card.querySelector('[data-new-until]');
          if (n && n.getAttribute('data-new-until') < today) n.remove();
        });
        window.__atlasSeen = marked;
      })();
      /* Saved sites, per browser (local only, nothing is sent anywhere).
         localStorage `atlas:saved` = [ids]; the first id is the top one.
         Save toggles; "up" moves a saved card to the top. Saved cards are
         listed first in the grid (Gallery.astro listens to `atlas:saved`). */
      (function () {
        var KEY = 'atlas:saved', saved = [];
        try { saved = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
        if (!Array.isArray(saved)) saved = [];
        var persist = function () { try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) {} };
        var paint = function () {
          document.querySelectorAll('[data-card]').forEach(function (card) {
            var on = saved.indexOf(card.getAttribute('data-id')) >= 0;
            card.classList.toggle('is-saved', on);
            var acts = card.querySelector('[data-card-actions]');
            if (acts) acts.hidden = false;
            var b = card.querySelector('[data-save]');
            if (b) {
              b.setAttribute('aria-pressed', on ? 'true' : 'false');
              var l = b.getAttribute(on ? 'data-label-saved' : 'data-label-save');
              b.setAttribute('aria-label', l); b.setAttribute('title', l);
            }
            var up = card.querySelector('[data-save-up]');
            if (up) {
              up.hidden = !on;
              up.disabled = saved[0] === card.getAttribute('data-id');
            }
          });
          document.querySelectorAll('[data-save-page]').forEach(function (b) {
            var on = saved.indexOf(b.getAttribute('data-save-page')) >= 0;
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
            b.classList.toggle('is-on', on);
            var lab = b.getAttribute(on ? 'data-label-saved' : 'data-label-save');
            if (b.hasAttribute('data-icon')) { b.setAttribute('aria-label', lab); b.setAttribute('title', lab); }
            else b.textContent = lab;
          });
          document.querySelectorAll('[data-saved-toggle]').forEach(function (b) {
            b.hidden = false;
            var n = b.querySelector('[data-saved-count]');
            if (n) n.textContent = saved.length ? String(saved.length) : '';
          });
        };
        document.addEventListener('click', function (e) {
          var t = e.target.closest && e.target.closest('[data-saved-toggle]');
          if (!t) return;
          if (document.querySelector('[data-cards]')) document.dispatchEvent(new Event('atlas:saved-toggle'));
          else location.href = t.getAttribute('data-href');
        });
        window.__atlasSaved = function () { return saved.slice(); };
        document.addEventListener('click', function (e) {
          var btn = e.target.closest && e.target.closest('[data-save], [data-save-up], [data-save-page]');
          if (!btn) return;
          var card = btn.closest('[data-card]');
          var id = btn.hasAttribute('data-save-page') ? btn.getAttribute('data-save-page') : card && card.getAttribute('data-id');
          if (!id) return;
          var rest = saved.filter(function (x) { return x !== id; });
          var act = 'save';
          if (btn.hasAttribute('data-save-up')) { saved = [id].concat(rest); act = 'move_up'; }
          else if (saved.indexOf(id) >= 0) { saved = rest; act = 'remove'; }
          else { saved = [id].concat(rest); act = 'save'; }
          persist(); paint();
          if (window.atlasTrack) window.atlasTrack('bookmark_click', { tool: id, action: act });
          document.dispatchEvent(new CustomEvent('atlas:saved', { detail: { ids: saved.slice() } }));
        });
        paint();
      })();
      /* Card "⋯" menu: open the site, copy its link, hide the card.
         Hidden sites, per browser: localStorage `atlas:hidden` = [ids]. They
         stay in the grid but move to its end (Gallery.astro listens to
         `atlas:hidden`); "Unhide" in the same menu brings a card back. */
      (function () {
        var KEY = 'atlas:hidden', hidden = [];
        try { hidden = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
        if (!Array.isArray(hidden)) hidden = [];
        window.__atlasHidden = function () { return hidden.slice(); };
        var paint = function () {
          document.querySelectorAll('[data-card]').forEach(function (card) {
            var on = hidden.indexOf(card.getAttribute('data-id')) >= 0;
            card.classList.toggle('is-dismissed', on);
            var b = card.querySelector('[data-card-hide] span');
            if (b) b.textContent = b.parentNode.getAttribute(on ? 'data-label-undo' : 'data-label');
          });
        };
        var openMenu = null;
        var close = function (focusBtn) {
          if (!openMenu) return;
          var wrap = openMenu.closest('[data-card]');
          openMenu.hidden = true;
          wrap.classList.remove('menu-open');
          var btn = wrap.querySelector('[data-card-more]');
          btn.setAttribute('aria-expanded', 'false');
          if (focusBtn) btn.focus();
          openMenu = null;
        };
        document.addEventListener('click', function (e) {
          if (!e.target.closest) return;
          var more = e.target.closest('[data-card-more]');
          if (more) {
            var menu = more.parentNode.querySelector('[data-card-menu]');
            var was = openMenu === menu;
            close();
            if (was) return;
            menu.hidden = false;
            more.setAttribute('aria-expanded', 'true');
            more.closest('[data-card]').classList.add('menu-open');
            openMenu = menu;
            var first = menu.querySelector('[role=menuitem]');
            if (first) first.focus({ preventScroll: true });
            return;
          }
          var copy = e.target.closest('[data-card-copy]');
          if (copy) {
            var url = copy.getAttribute('data-card-copy');
            var label = copy.querySelector('span');
            var ok = function () {
              label.textContent = copy.getAttribute('data-label-done');
              setTimeout(function () { close(); label.textContent = copy.getAttribute('data-label'); }, 900);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(ok, function () { close(); });
            else close();
            if (window.atlasTrack) window.atlasTrack('copy_link', { tool: copy.closest('[data-card]').getAttribute('data-id') });
            return;
          }
          var hide = e.target.closest('[data-card-hide]');
          if (hide) {
            var id = hide.closest('[data-card]').getAttribute('data-id');
            var was2 = hidden.indexOf(id) >= 0;
            hidden = hidden.filter(function (x) { return x !== id; });
            if (!was2) hidden.push(id);
            try { localStorage.setItem(KEY, JSON.stringify(hidden)); } catch (e2) {}
            close();
            paint();
            if (window.atlasTrack) window.atlasTrack('hide_click', { tool: id, action: was2 ? 'unhide' : 'hide' });
            document.dispatchEvent(new CustomEvent('atlas:hidden', { detail: { ids: hidden.slice() } }));
            return;
          }
          if (e.target.closest('[data-card-menu] a')) close();
        });
        document.addEventListener('pointerdown', function (e) {
          if (openMenu && !openMenu.parentNode.contains(e.target)) close();
        });
        document.addEventListener('keydown', function (e) {
          if (!openMenu) return;
          if (e.key === 'Escape') { e.preventDefault(); close(true); return; }
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            var items = Array.prototype.slice.call(openMenu.querySelectorAll('[role=menuitem]'));
            var i = items.indexOf(document.activeElement);
            e.preventDefault();
            items[(i + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length].focus();
          }
        });
        document.addEventListener('focusin', function (e) {
          if (openMenu && !openMenu.parentNode.contains(e.target)) close();
        });
        paint();
      })();
      /* User-controlled animation toggle (`atlas:motion` in localStorage)
         and scroll position restoration when navigating back (`atlas:scroll`
         in sessionStorage). */
      (function () {
        var MKEY = 'atlas:motion';
        var d = document.documentElement;
        var paintMotion = function () {
          var off = d.classList.contains('no-motion');
          document.querySelectorAll('[data-motion-toggle]').forEach(function (b) {
            b.setAttribute('aria-pressed', off ? 'true' : 'false');
            b.textContent = b.getAttribute(off ? 'data-label-off' : 'data-label-on');
          });
        };
        document.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('[data-motion-toggle]');
          if (!b) return;
          var off = !d.classList.contains('no-motion');
          d.classList.toggle('no-motion', off);
          try { off ? localStorage.setItem(MKEY, 'off') : localStorage.removeItem(MKEY); } catch (err) {}
          paintMotion();
          document.dispatchEvent(new CustomEvent('atlas:motion', { detail: { off: off } }));
        });
        paintMotion();

        var SKEY = 'atlas:scroll';
        var pathKey = location.pathname + location.search;
        var readScroll = function () { try { return JSON.parse(sessionStorage.getItem(SKEY) || '{}') || {}; } catch (e) { return {}; } };
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        if (nav && nav.type === 'back_forward' && !location.hash) {
          var y = Number(readScroll()[pathKey]);
          if (y > 0) window.scrollTo(0, y);
        }
        addEventListener('pagehide', function () {
          try {
            var map = readScroll();
            map[pathKey] = Math.round(window.scrollY);
            sessionStorage.setItem(SKEY, JSON.stringify(map));
          } catch (e) {}
        });
      })();
    </script>
    <Analytics lang={lang} />
    {/* accounts, member counter, prefs sync — only when the backend is configured */}
    <script>import '~/scripts/site';</script>
    <Counter />
  </body>
</html>
