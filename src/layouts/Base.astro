---
import { u } from '~/lib/url';
import '~/styles/atlas.css';
import sansFont from '~/assets/fonts/MedeoSansVariable.woff2?url';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { useTranslations, defaultLang, type Lang } from '~/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  image?: string;
  /** content starts under the floating bar instead of below it (Wall) */
  flush?: boolean;
  /** hide the footer (pages that are a single full-bleed view) */
  bare?: boolean;
  /** on a site's own page: its id, remembered as "viewed" */
  toolId?: string;
}

const { title, description, lang = defaultLang, image = u('/og/default.jpg'), flush = false, bare = false, toolId } = Astro.props;
const t = useTranslations(lang);
const fullTitle = title ? `${title} · ${t('site.name')}` : t('site.title');
const desc = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title={t('rss.title')} href={u('/rss.xml')} />
    <slot name="head" />
  </head>
  <body data-tool={toolId}>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} />
    <main id="main" class:list={{ 'main--flush': flush }}>
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
    {/* "Viewed" and "New", per browser. Inline at the end of the body so the
        marks are there on first paint. localStorage key: atlas:seen = [ids],
        most recent first. Without storage nothing is marked. */}
    <script is:inline>
      (function () {
        var KEY = 'atlas:seen', seen = [];
        try { seen = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
        if (!Array.isArray(seen)) seen = [];
        var marked = new Set(seen);
        var here = document.body.getAttribute('data-tool');
        if (here) {
          seen = [here].concat(seen.filter(function (id) { return id !== here; })).slice(0, 500);
          try { localStorage.setItem(KEY, JSON.stringify(seen)); } catch (e) {}
        }
        var today = new Date().toISOString().slice(0, 10);
        document.querySelectorAll('[data-card]').forEach(function (card) {
          if (marked.has(card.getAttribute('data-id'))) {
            card.classList.add('is-seen');
            var b = card.querySelector('[data-seen-badge]');
            if (b) b.hidden = false;
          }
          var n = card.querySelector('[data-new-until]');
          if (n && n.getAttribute('data-new-until') < today) n.remove();
        });
        window.__atlasSeen = marked;
      })();
    </script>
  </body>
</html>
