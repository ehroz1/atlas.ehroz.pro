---
/**
 * Wall: every screenshot on one endless plane you can move freely in any
 * direction — wheel/trackpad, drag (mouse or finger), arrow keys.
 *
 * No native scrolling: the page doesn't scroll at all, so there are no
 * scrollbars and no axis-locking. A small "camera" script moves the plane
 * with transform, easing towards a target and coasting after a drag.
 * The server renders one block of ROWS × COLS tiles (brick-offset rows);
 * the script tiles it 3 × 3 and shows position modulo one block, so the
 * wall never ends and never jumps.
 */
import { u } from '~/lib/url';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import { getTools } from '~/lib/data';
import { shotFor } from '~/lib/shots';
import { getPage } from '~/lib/routes';
import { useTranslations, type Lang } from '~/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const entry = await getPage('wall');

const tools = (await getTools()).filter((x) => shotFor(x.id));
// One block holds every site exactly once (a few repeat only when the count
// doesn't fill the last row). Rows stay even so the brick offset repeats cleanly.
const COLS = 11;
const ROWS = 2 * Math.ceil(tools.length / (2 * COLS));
const pick = (r: number, c: number) => tools[(r * COLS + c) % tools.length];
const seen = new Set<string>();
---
<Base lang={lang} entry={entry} flush bare>
  <h1 class="visually-hidden">{t('wall.h1')}</h1>
  <p class="visually-hidden">{t('wall.description')}</p>
  <div class="wall" tabindex="0" aria-label={t('wall.aria')} data-wall data-cols={COLS} data-rows={ROWS}>
    <div class="wall__plane" data-wall-plane>
      {Array.from({ length: ROWS }, (_, r) => (
        <div class="wall__row">
          {Array.from({ length: COLS }, (_, c) => {
            const tool = pick(r, c);
            const first = !seen.has(tool.id);
            seen.add(tool.id);
            return (
              <a class="wall__item" href={u(`/tool/${tool.id}`, lang)} draggable="false"
                aria-label={first ? tool.data.name : undefined}
                aria-hidden={first ? undefined : 'true'}
                tabindex={first ? undefined : -1}>
                <Image src={shotFor(tool.id)!} alt="" draggable="false" widths={[480, 720]} sizes="(min-width: 48rem) 21vw, 45vw" format="webp" quality={74} loading="eager" />
                <span class="wall__label">{tool.data.name}</span>
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </div>
  <p class="wall__hint" data-wall-hint>{t('wall.hint')}</p>
</Base>

<script>
  const wall = document.querySelector<HTMLElement>('[data-wall]')!;
  const plane = document.querySelector<HTMLElement>('[data-wall-plane]')!;
  const hint = document.querySelector<HTMLElement>('[data-wall-hint]');
  const COLS = Number(wall.dataset.cols);
  const ROWS = Number(wall.dataset.rows);
  const isReduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('no-motion');
  document.documentElement.classList.add('is-wall');

  // 1. Tile the block 3 × 3: triple every row, then triple the rows.
  const baseRows = Array.from(plane.children) as HTMLElement[];
  const hide = (el: HTMLElement) => {
    // `el` is a whole row (links inside) or a single tile that is itself the link
    const links = el.matches('a') ? [el] : Array.from(el.querySelectorAll('a'));
    links.forEach((a) => {
      a.setAttribute('aria-hidden', 'true');
      a.tabIndex = -1;
      a.removeAttribute('aria-label');
      // copies are only filler: don't fetch or decode them until they scroll near
      a.querySelectorAll('img').forEach((img) => { img.loading = 'lazy'; img.decoding = 'async'; });
    });
    return el;
  };
  for (const row of baseRows) {
    const items = Array.from(row.children);
    for (let k = 0; k < 2; k++) items.forEach((it) => row.append(hide(it.cloneNode(true) as HTMLElement)));
  }
  plane.prepend(...baseRows.map((r) => hide(r.cloneNode(true) as HTMLElement)));
  plane.append(...baseRows.map((r) => hide(r.cloneNode(true) as HTMLElement)));

  // 2. Block size = distance from a tile to its copy one block away.
  let blockW = 1;
  let blockH = 1;
  const measure = () => {
    const rows = plane.children as HTMLCollectionOf<HTMLElement>;
    const first = rows[0].children as HTMLCollectionOf<HTMLElement>;
    blockW = first[COLS].offsetLeft - first[0].offsetLeft;
    blockH = rows[ROWS].offsetTop - rows[0].offsetTop;
  };
  measure();

  // 3. Camera. (x, y) is unbounded; what's drawn is (x, y) modulo a block,
  //    offset into the middle copy, so the view never runs out of tiles.
  const mod = (n: number, m: number) => ((n % m) + m) % m;
  let x = blockW / 2 - innerWidth / 2;
  let y = blockH / 2 - innerHeight / 2;
  let tx = x;
  let ty = y;
  // Which copy of the tiled block is drawn first. 1 is the middle copy (the default);
  // 0 shows the original tiles, so a keyboard-focused tile can be the one on screen.
  let kx = 1;
  let ky = 1;
  let vx = 0; // coasting velocity after a drag, px/s
  let vy = 0;
  let dragging = false;
  let last = performance.now();
  let running = false;

  const draw = () => {
    plane.style.transform = `translate3d(${-(kx * blockW + mod(x, blockW))}px, ${-(ky * blockH + mod(y, blockH))}px, 0)`;
  };
  const frame = (now: number) => {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    if (!dragging && (vx || vy)) {
      tx += vx * dt;
      ty += vy * dt;
      const decay = Math.exp(-dt * 5); // friction
      vx *= decay;
      vy *= decay;
      if (Math.hypot(vx, vy) < 8) vx = vy = 0;
    }
    const k = isReduced() || dragging ? 1 : 1 - Math.exp(-dt * 14); // ease toward target
    x += (tx - x) * k;
    y += (ty - y) * k;
    draw();
    if (Math.abs(tx - x) > 0.3 || Math.abs(ty - y) > 0.3 || vx || vy || dragging) requestAnimationFrame(frame);
    else running = false;
  };
  const kick = () => {
    if (hint && !hint.classList.contains('is-hidden')) hint.classList.add('is-hidden');
    if (running) return;
    running = true;
    last = performance.now();
    requestAnimationFrame(frame);
  };
  draw();

  // 4. Wheel / trackpad — both axes at once, no rails.
  const blocked = (t: EventTarget | null) => !!(t as HTMLElement | null)?.closest?.('.finder, .menu') || !!document.querySelector('dialog[open], .finder:not([hidden])');
  addEventListener('wheel', (e) => {
    if (e.ctrlKey || blocked(e.target)) return; // leave pinch-zoom alone
    e.preventDefault();
    const unit = e.deltaMode === 1 ? 40 : e.deltaMode === 2 ? innerHeight : 1;
    tx += e.deltaX * unit;
    ty += e.deltaY * unit;
    vx = vy = 0;
    kick();
  }, { passive: false });

  // 5. Drag with mouse, pen or finger; coast after release.
  let start: { px: number; py: number; x: number; y: number; moved: boolean } | null = null;
  const samples: { t: number; px: number; py: number }[] = [];
  let suppressClick = false;
  wall.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    suppressClick = false; // a new gesture: forget the last drag
    // grabbing a coasting wall stops it where it is
    tx = x;
    ty = y;
    start = { px: e.clientX, py: e.clientY, x: tx, y: ty, moved: false };
    samples.length = 0;
    samples.push({ t: performance.now(), px: e.clientX, py: e.clientY });
    vx = vy = 0;
  });
  addEventListener('pointermove', (e) => {
    if (!start) return;
    const dx = e.clientX - start.px;
    const dy = e.clientY - start.py;
    if (!start.moved && Math.hypot(dx, dy) > 5) {
      start.moved = true;
      dragging = true;
      wall.classList.add('is-dragging');
      try { wall.setPointerCapture(e.pointerId); } catch {}
    }
    if (!start.moved) return;
    tx = start.x - dx;
    ty = start.y - dy;
    const now = performance.now();
    samples.push({ t: now, px: e.clientX, py: e.clientY });
    while (samples.length > 2 && now - samples[0].t > 100) samples.shift();
    kick();
  });
  const end = () => {
    if (!start) return;
    if (start.moved) {
      suppressClick = true;
      const a = samples[0];
      const b = samples[samples.length - 1];
      const dt = (b.t - a.t) / 1000;
      if (!isReduced() && dt > 0 && performance.now() - b.t < 80) {
        vx = -(b.px - a.px) / dt;
        vy = -(b.py - a.py) / dt;
      }
    }
    start = null;
    dragging = false;
    wall.classList.remove('is-dragging');
    kick();
  };
  addEventListener('pointerup', end);
  addEventListener('pointercancel', end);
  wall.addEventListener('click', (e) => {
    if (suppressClick) {
      e.preventDefault();
      e.stopPropagation();
      suppressClick = false;
    }
  }, true);

  // 6. Keyboard: arrows nudge, Page/Space jump a screen.
  addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement;
    if (blocked(el) || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName) || e.metaKey || e.ctrlKey || e.altKey) return;
    // Space belongs to a focused button, link or summary (menu button, tiles): leave it alone
    if (e.key === ' ' && el.closest?.('button, a, summary, [role="button"], [role="menuitem"]')) return;
    const step = 180;
    const page = innerHeight * 0.8;
    const moves: Record<string, [number, number]> = {
      ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step],
      PageUp: [0, -page], PageDown: [0, page], ' ': [0, e.shiftKey ? -page : page],
    };
    const m = moves[e.key];
    if (!m) return;
    e.preventDefault();
    vx = vy = 0;
    tx += m[0];
    ty += m[1];
    kick();
  });

  // 7. Keep the same spot when the window or layout changes size.
  addEventListener('resize', () => {
    const fx = mod(x, blockW) / blockW;
    const fy = mod(y, blockH) / blockH;
    measure();
    x = tx = fx * blockW;
    y = ty = fy * blockH;
    draw();
  });

  // Tabbing to a tile brings it into view. The wall is the same block tiled 3 × 3 and
  // the focusable tiles are the originals, so the camera has to move to the original,
  // not to whichever copy happens to be near: pick the copy of the block that shows it,
  // then centre the camera on it. The copies are identical, so the switch is invisible.
  // The browser itself tries to scroll a focused tile into view inside the clipped wall,
  // which would shift everything by whole blocks; the camera is the only thing that moves.
  const pin = () => { wall.scrollLeft = 0; wall.scrollTop = 0; };
  wall.addEventListener('scroll', pin);
  wall.addEventListener('focusin', (e) => {
    const a = (e.target as HTMLElement).closest('a');
    if (!a) return;
    pin();
    const r = a.getBoundingClientRect();
    if (r.left >= 0 && r.right <= innerWidth && r.top >= 72 && r.bottom <= innerHeight) {
      // already clear of the edges and the bar: stop an earlier glide so it doesn't carry the tile away
      tx = x;
      ty = y;
      vx = vy = 0;
      return;
    }
    const pr = plane.getBoundingClientRect();
    const px = r.left - pr.left; // the tile's place inside the plane, whatever the camera does
    const py = r.top - pr.top;
    // columns: the originals are the first copy (0 .. blockW)
    kx = 0;
    // keep 2px off the block's seam: right on it, rounding decides which side of the wrap the camera lands on
    const keep = (v: number, size: number) => Math.min(size - 2, Math.max(2, v));
    const mx = keep(px - (innerWidth - r.width) / 2, blockW);
    // rows: the originals are the middle copy (blockH .. 2 * blockH)
    const my = py - blockH - (innerHeight - r.height) / 2;
    if (my >= 0) { ky = 1; } else { ky = 0; }
    const targetY = keep(my >= 0 ? my : my + blockH, blockH);
    // shortest way there, modulo one block
    const dx = mod(mx - mod(x, blockW) + blockW / 2, blockW) - blockW / 2;
    const dy = mod(targetY - mod(y, blockH) + blockH / 2, blockH) - blockH / 2;
    vx = vy = 0;
    tx = x + dx;
    ty = y + dy;
    kick();
  });
</script>
