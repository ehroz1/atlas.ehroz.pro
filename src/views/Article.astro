---
import { u } from '~/lib/url';
import Base from '~/layouts/Base.astro';
import ToolCard from '~/components/ToolCard.astro';
import Comments from '~/components/Comments.astro';
import ArticleCover from '~/components/ArticleCover.astro';
import { getTools, getCategories, domainOf } from '~/lib/data';
import { getArticles, type Article } from '~/lib/articles';
import { getPage, AUTHOR_SLUG } from '~/lib/routes';
import { blogPosting } from '~/lib/schema';
import { absUrl } from '~/lib/seo';
import { AUTHOR, SITE } from '~/site.config';
import { useTranslations, loc, formatDate, type Lang } from '~/i18n';

interface Props { article: Article; lang: Lang }
const { article, lang } = Astro.props;
const t = useTranslations(lang);
const d = article.entry[lang].data;
const [all, categories, articles, entry] = await Promise.all([getTools(), getCategories(), getArticles(), getPage(`blog/${article.slug}`)]);
const names = new Map(categories.map((c) => [c.id, loc(c.data.name, lang)]));
const tools = article.tools.map((id) => all.find((x) => x.id === id)!);
const url = absUrl(entry.path, lang);
const iso = (x: Date) => x.toISOString().slice(0, 10);
const changed = iso(article.updated) !== iso(article.published);
const toc = article.toc[lang];
// other articles: ones sharing a category first, then the newest
const shares = (a: Article) => Number(a.categories.some((c) => article.categories.includes(c)));
const others = articles.filter((a) => a.slug !== article.slug).sort((a, b) => shares(b) - shares(a)).slice(0, 3);
const enc = encodeURIComponent;
const share = [
  { name: 'Telegram', href: `https://t.me/share/url?url=${enc(url)}&text=${enc(d.title)}` },
  { name: 'X', href: `https://x.com/intent/post?url=${enc(url)}&text=${enc(d.title)}` },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}` },
];
const initials = AUTHOR.name.slice(0, 1);
---
<Base
  lang={lang}
  entry={entry}
  crumbs={[{ name: t('nav.blog'), path: '/blog' }, { name: d.title, path: entry.path }]}
  crumbsContainer="container container--article"
  nodes={[blogPosting(url, entry, lang)]}
  pageExtra={{ mainEntity: { '@id': url + '#article' } }}
>
  <div class="reading-progress" aria-hidden="true"></div>

  <article class="article" data-article={article.slug}>
    <div class="container container--article">
      <header class="article-head">
        <ul class="article-head__cats" role="list">
          {article.categories.map((c) => <li><a class="chip" href={u(`/category/${c}`, lang)}>{names.get(c)}</a></li>)}
        </ul>
        <h1 class="article-head__title">{d.title}</h1>
        <p class="article-head__lead">{d.description}</p>
        <div class="article-meta">
          <a class="article-meta__author" href={u(`/author/${AUTHOR_SLUG}`, lang)} rel="author">
            <span class="avatar" aria-hidden="true">{initials}</span>
            <span>{AUTHOR.name}</span>
          </a>
          <span class="article-meta__items">
            <time datetime={iso(article.published)}>{formatDate(article.published, lang)}</time>
            {changed && <span>{t('article.updated')} <time datetime={iso(article.updated)}>{formatDate(article.updated, lang)}</time></span>}
            <span>{t('article.minutes', { n: article.minutes[lang] })}</span>
            <span data-views={article.slug} data-label={t('article.views')} hidden><span data-views-text></span></span>
          </span>
        </div>
      </header>

      <ArticleCover article={article} lang={lang} size="hero" eager />

      <div class="article-col">
        {toc.length > 2 && (
          <aside class="article-rail" aria-labelledby="rail-h">
            <nav class="article-rail__nav" aria-labelledby="rail-h" data-toc>
              <p class="article-aside__label" id="rail-h">{t('article.toc')}</p>
              <ol role="list">
                {toc.map((h) => <li><a href={`#${h.id}`} data-toc-link={h.id}>{h.text}</a></li>)}
              </ol>
            </nav>
          </aside>
        )}
        {toc.length > 2 && (
          <details class="article-toc">
            <summary>{t('article.toc')} <span class="t-meta">· {toc.length}</span></summary>
            <ol role="list">
              {toc.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}
            </ol>
          </details>
        )}
        <div class="article-body">
          <div class="prose prose--article" set:html={article.html[lang]} />

          {d.sources.length > 0 && (
            <section class="article-sources" aria-labelledby="sources">
              <h2 class="t-title" id="sources">{t('article.sources')}</h2>
              <ul role="list">
                {d.sources.map((s) => <li><a class="link" href={s} rel="noopener nofollow">{domainOf(s)}{new URL(s).pathname.length > 1 ? new URL(s).pathname : ''}</a></li>)}
              </ul>
            </section>
          )}

          <section class="author-card" aria-labelledby="author-h">
            <span class="avatar avatar--lg" aria-hidden="true">{initials}</span>
            <div class="stack" style="--gap: var(--s-2)">
              <p class="article-aside__label" id="author-h">{t('article.aboutAuthor')}</p>
              <p class="t-medium">{AUTHOR.name}</p>
              <p class="t-secondary t-small">{t('article.authorBio')}</p>
              <p class="cluster t-small" style="--gap: var(--s-2) var(--s-4)">
                <a class="link" href={u(`/author/${AUTHOR_SLUG}`, lang)} rel="author">{t('author.all', { name: AUTHOR.name })}</a>
                <a class="link" href={AUTHOR.url}>{t('article.authorSite')}</a>
                <a class="link" href={AUTHOR.telegram.url} rel="noopener">Telegram</a>
                <a class="link" href={u('/about', lang)}>{SITE.name}</a>
              </p>
            </div>
          </section>

          <div class="article-share">
            <span class="t-meta">{t('article.share')}</span>
            {share.map((sh) => <a class="chip" href={sh.href} target="_blank" rel="noopener nofollow">{sh.name}</a>)}
            <button class="chip" type="button" data-copy-link data-done={t('article.copied')}>{t('article.copy')}</button>
          </div>

          <div class="article-comments">
            <Comments toolId={`blog-${article.slug}`} lang={lang} next={`blog/${article.slug}/`} />
          </div>
        </div>
      </div>
    </div>
  </article>

  <div class="container container--wide">
    <section class="section--more" aria-labelledby="tools">
      <div class="section-head">
        <h2 class="t-title" id="tools">{t('article.tools')}</h2>
      </div>
      <div class="cards">
        {tools.map((x) => <ToolCard tool={x} categoryName={names.get(x.data.category)!} lang={lang} />)}
      </div>
    </section>
  </div>

  {others.length > 0 && (
    <div class="container container--wide">
      <section class="section--more" aria-labelledby="more">
        <div class="section-head">
          <h2 class="t-title" id="more">{t('article.related')}</h2>
          <a class="link t-small" href={u('/blog', lang)}>{t('article.all')}</a>
        </div>
        <ul class="post-grid" role="list">
          {others.map((a) => (
            <li class="post-card">
              <a class="post-card__link" href={u(`/blog/${a.slug}`, lang)}>
                <ArticleCover article={a} lang={lang} />
                <span class="post-card__title">{a.entry[lang].data.title}</span>
              </a>
              <p class="post-card__meta t-meta">
                <time datetime={iso(a.published)}>{formatDate(a.published, lang)}</time> · {t('article.minutes', { n: a.minutes[lang] })}
              </p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  )}
</Base>

<script>
  import { hitArticle } from '~/scripts/views';

  const art = document.querySelector<HTMLElement>('[data-article]');
  if (art) hitArticle(art.dataset.article!);

  // reading progress for browsers without scroll-driven animations
  const bar = document.querySelector<HTMLElement>('.reading-progress');
  if (bar && !CSS.supports('animation-timeline: scroll()')) {
    let queued = false;
    const paint = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(paint); } }, { passive: true });
    paint();
  }

  // side contents: highlight the section being read
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const heads = links.map((a) => document.getElementById(a.dataset.tocLink!)).filter((x): x is HTMLElement => !!x);
  if (heads.length) {
    let ticking = false;
    const mark = () => {
      ticking = false;
      const line = innerHeight * 0.3;
      let cur = '';
      for (const h of heads) if (h.getBoundingClientRect().top <= line) cur = h.id;
      for (const a of links) {
        if (a.dataset.tocLink === cur) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(mark); } }, { passive: true });
    mark();
  }

  // copy link
  const copy = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.origin + location.pathname);
      const label = copy.textContent;
      copy.textContent = copy.dataset.done ?? label;
      setTimeout(() => (copy.textContent = label), 1600);
    } catch {
      /* clipboard blocked */
    }
  });

</script>
