---
import { u } from '~/lib/url';
/**
 * About, laid out like deck.gallery's pricing page: centered headline,
 * two columns of screenshots drifting up and down along the page frame
 * (cut by its lines), three joined columns with the middle one raised.
 * Every number here is computed from the data.
 */
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import { getTools, getCategories } from '~/lib/data';
import { shotFor } from '~/lib/shots';
import { formatDate } from '~/i18n';

const [tools, categories] = await Promise.all([getTools(), getCategories()]);
const free = tools.filter((x) => x.data.pricing !== 'paid').length;
const latest = new Date(Math.max(...tools.map((x) => x.data.added.getTime())));

const withShots = tools.filter((x) => shotFor(x.id));
// Two columns of shots riding up (left) and down (right) along the frame
// lines; dx staggers them sideways, in shot widths, so the frame cuts
// each one by a different amount.
const PER_SIDE = 6;
const side = (offset: number, dxs: number[]) =>
  Array.from({ length: PER_SIDE }, (_, i) => ({ tool: withShots[(offset + i * 7) % withShots.length], dx: dxs[i % dxs.length] }));
const left = side(3, [0.22, -0.3, -0.45, -0.28, 0.2, -0.38]);
const right = side(40, [-0.25, 0.42, 0.45, 0.4, -0.15, 0.38]);
const icon = {
  check: 'M4.5 10.5 8 14l7.5-8',
  x: 'M5.5 5.5l9 9M14.5 5.5l-9 9',
  search: 'M8.6 14.6a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm4.6-1.4 4.3 4.3',
  grid: 'M3 3h6v6H3zM11 3h6v6h-6zM3 11h6v6H3zM11 11h6v6h-6z',
  wall: 'M2.5 4h7v5h-7zM10.5 4h7v5h-7zM6.5 11h7v5h-7z',
  key: 'M3 6h14v9H3zM6 12h8M6 9h.01M9 9h.01M12 9h.01M15 9h.01',
  plus: 'M10 4v12M4 10h12',
};
---
<Base title="About" description="What Atlas is, how sites get in, and what we leave out.">
  <div class="page-stage">
    <div class="edge-shots" aria-hidden="true" data-edge-shots>
      {left.map(({ tool, dx }) => (
        <div class="edge-shots__item" data-side="left" data-dx={dx}>
          <Image src={shotFor(tool.id)!} alt="" widths={[320, 480]} sizes="13vw" format="webp" quality={72} />
        </div>
      ))}
      {right.map(({ tool, dx }) => (
        <div class="edge-shots__item" data-side="right" data-dx={dx}>
          <Image src={shotFor(tool.id)!} alt="" widths={[320, 480]} sizes="13vw" format="webp" quality={72} />
        </div>
      ))}
    </div>

    <div class="container">
      <div style="padding-block: clamp(var(--s-8), 4vw, var(--s-12)) clamp(var(--s-10), 4.5vw, var(--s-12))">
        <h1 class="t-headline">Useful sites, hand-picked<br />to help you make things</h1>
        <p class="t-center t-muted mt-6" style="font-size: var(--fs-15)">Updated {formatDate(latest)}</p>
      </div>

      <div class="plans">
        <article class="plan">
          <h2 class="plan__name">Hand-picked</h2>
          <p class="plan__sub">How a site gets in</p>
          <hr class="plan__rule" />
          <p class="plan__figure">{tools.length}</p>
          <p class="plan__caption">sites so far</p>
          <hr class="plan__rule" />
          <ul class="plan__list">
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.check} /></svg>Used for a while before it's listed</li>
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.check} /></svg>Does one job better than the obvious pick</li>
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.check} /></svg>Clear within a minute of landing on it</li>
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.check} /></svg>No forced sign-up just to look around</li>
          </ul>
          <div class="plan__foot">
            <a class="btn btn--chrome" href={u('/')}>Browse sites</a>
            <span class="plan__note">{free} of them have a free plan</span>
          </div>
        </article>

        <article class="plan plan--raised">
          <span class="plan__flag">Free</span>
          <h2 class="plan__name">Open</h2>
          <p class="plan__sub">Nothing to sign up for</p>
          <hr class="plan__rule" />
          <p class="plan__figure">$0</p>
          <p class="plan__caption">no account, no paywall</p>
          <hr class="plan__rule" />
          <ul class="plan__list">
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.search} /></svg>Search &amp; filters</li>
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.grid} /></svg>{categories.length} categories</li>
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.wall} /></svg>Wall of every screenshot</li>
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.key} /></svg>Press / to search anywhere</li>
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.plus} /></svg>Anyone can suggest a site</li>
          </ul>
          <div class="plan__foot">
            <a class="btn btn--accent" href={u('/submit')}>Submit a site</a>
            <span class="plan__note">Takes about a minute</span>
          </div>
        </article>

        <article class="plan">
          <h2 class="plan__name">Honest</h2>
          <p class="plan__sub">What we leave out</p>
          <hr class="plan__rule" />
          <p class="plan__figure">0</p>
          <p class="plan__caption">sponsored placements</p>
          <hr class="plan__rule" />
          <ul class="plan__list">
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.x} /></svg>Paid rankings</li>
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.x} /></svg>Affiliate lists</li>
            <li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.x} /></svg>“Top 100 AI tools”</li>
          </ul>
          <div class="plan__foot">
            <a class="btn btn--chrome" href={u('/categories')}>See categories</a>
            <span class="plan__note">Outbound links carry only a ref tag</span>
          </div>
        </article>
      </div>
    </div>
  </div>
</Base>

<script>
  const box = document.querySelector<HTMLElement>('[data-edge-shots]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  if (box) {
    const items = Array.from(box.querySelectorAll<HTMLElement>('.edge-shots__item'));
    const lefts = items.filter((el) => el.dataset.side === 'left');
    const rights = items.filter((el) => el.dataset.side === 'right');
    const SPEED = 22; // px per second
    let W = 0, H = 0, tw = 0, th = 0, gap = 0, len = 0;
    const measure = () => {
      W = box.clientWidth;
      H = box.clientHeight;
      tw = items[0].offsetWidth;
      th = items[0].offsetHeight;
      gap = Math.max(th * 1.9, (H + th) / lefts.length);
      len = gap * lefts.length;
    };
    let t = 0;
    const place = (list: HTMLElement[], dir: number, xFor: (dx: number) => number) =>
      list.forEach((el, i) => {
        const y = ((((i * gap + dir * t * SPEED) % len) + len) % len) - th;
        el.style.transform = `translate3d(${xFor(Number(el.dataset.dx))}px, ${y}px, 0)`;
      });
    const draw = () => {
      place(lefts, -1, (dx) => dx * tw); // left column rides up
      place(rights, 1, (dx) => W - tw + dx * tw); // right column rides down
    };
    let running = false, visible = true, last = 0;
    const frame = (now: number) => {
      if (!running) return;
      t += Math.min(0.05, (now - last) / 1000);
      last = now;
      draw();
      requestAnimationFrame(frame);
    };
    const start = () => {
      if (running || !visible || reduced.matches || !box.offsetWidth) return;
      running = true;
      last = performance.now();
      requestAnimationFrame(frame);
    };
    box.classList.add('is-live');
    measure();
    draw();
    start();
    new ResizeObserver(() => { measure(); draw(); start(); }).observe(box);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : (running = false); }).observe(box);
  }
</script>
