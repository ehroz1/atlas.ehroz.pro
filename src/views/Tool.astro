---
import { u } from '~/lib/url';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import ToolCard from '~/components/ToolCard.astro';
import Comments from '~/components/Comments.astro';
import { getTools, getCategories, domainOf, type Tool } from '~/lib/data';
import { shotFor } from '~/lib/shots';
import { alternativesOf, similarTo } from '~/lib/related';
import { getPage } from '~/lib/routes';
import { articlesWithTool } from '~/lib/articles';
import { software } from '~/lib/schema';
import { absUrl } from '~/lib/seo';
import { SITE, AUTHOR } from '~/site.config';
import { useTranslations, loc, formatDate, type Lang } from '~/i18n';

interface Props { tool: Tool; lang: Lang }
const { tool, lang } = Astro.props;
const d = tool.data;
const t = useTranslations(lang);

const [all, categories, entry, articles] = await Promise.all([getTools(), getCategories(), getPage(`tool/${tool.id}`), articlesWithTool(tool.id)]);
const category = categories.find((c) => c.id === d.category)!;
const categoryName = loc(category.data.name, lang);
const names = new Map(categories.map((c) => [c.id, loc(c.data.name, lang)]));
const alternatives = alternativesOf(tool, all);
const similar = similarTo(tool, all, new Set(alternatives.map((x) => x.id)));
const shot = shotFor(tool.id);
const domain = domainOf(d.url);
// a partner link goes out as is (its own tracking), a normal one gets ?ref=
const outbound = new URL(d.affiliateUrl ?? d.url);
if (!d.affiliateUrl) outbound.searchParams.set('ref', SITE.ref);
const rel = d.affiliateUrl ? 'sponsored noopener' : 'noopener';
const url = absUrl(entry.path, lang);

const pricing = [t(`pricing.${d.pricing}`), d.openSource ? t('pricing.openSource') : null].filter(Boolean).join(', ');
---
<Base
  lang={lang}
  entry={entry}
  crumbs={[{ name: categoryName, path: `/category/${category.id}` }, { name: d.name, path: entry.path }]}
  nodes={[software(url, tool, lang, categoryName)]}
  pageExtra={{ mainEntity: { '@id': url + '#software' }, about: { '@id': url + '#software' } }}
  toolId={tool.id}
>
  <div class="container">
    <header class="tool-head">
      <div class="tool-head__title">
        <h1 class="t-display">{d.name}</h1>
        <p class="t-lead tool-head__lead">{loc(d.description, lang)}</p>
        {d.note && (
          <figure class="author-note">
            <blockquote><p>{loc(d.note, lang)}</p></blockquote>
            <figcaption>— {t('tool.note', { name: AUTHOR.name })}</figcaption>
          </figure>
        )}
        <div class="tool-head__actions">
          <a class="btn btn--solid" href={outbound.href} target="_blank" rel={rel} data-track-tool={tool.id}>
            {t('tool.visit', { domain })} <span class="btn__arrow" aria-hidden="true">↗</span>
          </a>
          <button class="btn btn--icon" type="button" data-save-page={tool.id} data-icon aria-pressed="false"
            data-label-save={t('tool.save')} data-label-saved={t('tool.saved')} aria-label={t('tool.save')} title={t('tool.save')}>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 3.5h9v13L10 13.2l-4.5 3.3v-13Z"/></svg>
          </button>
          <button class="btn btn--icon" type="button" data-copy data-label-copy={t('tool.copy')} data-label-done={t('tool.copied')} aria-label={t('tool.copy')} title={t('tool.copy')}>
            <svg class="i-copy" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 11.5a3 3 0 0 0 4.2 0l2.6-2.6a3 3 0 0 0-4.2-4.2l-.9.9"/><path d="M11.5 8.5a3 3 0 0 0-4.2 0l-2.6 2.6a3 3 0 0 0 4.2 4.2l.9-.9"/></svg>
            <svg class="i-done" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 10.5l3.5 3.5 7.5-8"/></svg>
          </button>
        </div>
        {d.affiliateUrl && (
          <p class="partner-note t-meta"><span class="card__partner">{t('tool.partner')}</span> {t('tool.partnerHint')}</p>
        )}
      </div>

      <dl class="meta">
        <div class="meta__row">
          <dt>{t('tool.category')}</dt>
          <dd><a href={u(`/category/${category.id}`, lang)}>{categoryName}</a></dd>
        </div>
        <div class="meta__row">
          <dt>{t('tool.pricing')}</dt>
          <dd>{pricing}</dd>
        </div>
        {d.platforms.length > 0 && (
          <div class="meta__row">
            <dt>{t('tool.platforms')}</dt>
            <dd>{d.platforms.join(', ')}</dd>
          </div>
        )}
        <div class="meta__row">
          <dt>{t('tool.tags')}</dt>
          <dd class="tags">
            {d.tags.map((tag) => <a class="tag" href={u('/search', lang) + `?q=${encodeURIComponent(tag)}`}>{tag}</a>)}
          </dd>
        </div>
        <div class="meta__row">
          <dt>{t('tool.added')}</dt>
          <dd><time datetime={d.added.toISOString().slice(0, 10)}>{formatDate(d.added, lang)}</time></dd>
        </div>
      </dl>
    </header>

    <a class="tile" href={outbound.href} target="_blank" rel={rel} aria-label={t('tool.visit', { domain })} data-track-tool={tool.id}>
      {shot ? (
        <Image
          class="tile__shot"
          src={shot}
          alt={t('tool.shotAlt', { name: d.name })}
          widths={[720, 1080, 1440]}
          sizes="(min-width: 64rem) 820px, 90vw"
          loading="eager"
          fetchpriority="high"
          format="webp"
          quality={82}
        />
      ) : (
        <div class="shot-fallback">{domain}</div>
      )}
    </a>

    <Comments toolId={tool.id} lang={lang} />

    {articles.length > 0 && (
      <section class="section--more" aria-labelledby="articles">
        <div class="section-head">
          <h2 class="t-title" id="articles">{t('tool.articles', { name: d.name })}</h2>
        </div>
        <ul class="stack" style="--gap: var(--s-3)" role="list">
          {articles.slice(0, 5).map((a) => (
            <li class="stack" style="--gap: var(--s-1)">
              <a class="link" href={u(`/blog/${a.slug}`, lang)}>{a.entry[lang].data.title}</a>
              <span class="t-meta">{a.entry[lang].data.description}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {alternatives.length > 0 && (
      <section class="section--more" aria-labelledby="alternatives">
        <div class="section-head">
          <h2 class="t-title" id="alternatives">{t('tool.alternatives', { name: d.name })}</h2>
          {alternatives.length >= 2 && (
            <a class="link t-small" href={u(`/alternatives/${tool.id}`, lang)}>{t('tool.allAlternatives', { name: d.name })}</a>
          )}
        </div>
        <div class="cards">
          {alternatives.map((r) => <ToolCard tool={r} categoryName={names.get(r.data.category)!} lang={lang} />)}
        </div>
      </section>
    )}

    {similar.length > 0 && (
      <section class="section--more" aria-labelledby="similar">
        <div class="section-head">
          <h2 class="t-title" id="similar">{t('tool.similar')}</h2>
          <a class="link t-small" href={u(`/category/${category.id}`, lang)}>{t('tool.more', { category: categoryName })}</a>
        </div>
        <div class="cards">
          {similar.map((r) => <ToolCard tool={r} categoryName={names.get(r.data.category)!} lang={lang} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const setLabel = (text: string) => {
    if (!btn) return;
    btn.setAttribute('aria-label', text);
    btn.title = text;
  };
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.origin + location.pathname);
      btn.classList.add('is-done');
      setLabel(btn.dataset.labelDone ?? 'Copied');
      setTimeout(() => {
        btn.classList.remove('is-done');
        setLabel(btn.dataset.labelCopy ?? 'Copy link');
      }, 1600);
    } catch {
      /* clipboard blocked — nothing to do */
    }
  });
</script>
