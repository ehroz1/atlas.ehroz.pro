---
import { u } from '~/lib/url';
import Base from '~/layouts/Base.astro';
import ArticleCover from '~/components/ArticleCover.astro';
import { getArticles, type Article } from '~/lib/articles';
import { getCategories } from '~/lib/data';
import { getPage, AUTHOR_SLUG } from '~/lib/routes';
import { absUrl } from '~/lib/seo';
import { AUTHOR } from '~/site.config';
import { useTranslations, loc, formatDate, type Lang } from '~/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const [articles, categories, entry] = await Promise.all([getArticles(), getCategories(), getPage('blog')]);
const names = new Map(categories.map((c) => [c.id, loc(c.data.name, lang)]));
const url = absUrl(entry.path, lang);
const iso = (x: Date) => x.toISOString().slice(0, 10);
const [lead, ...rest] = articles;
// topics used by at least one article, most used first; the filter row shows when there are 2+
const used = [...new Set(articles.flatMap((a) => a.categories))]
  .map((id) => ({ id, name: names.get(id)!, n: articles.filter((a) => a.categories.includes(id)).length }))
  .sort((a, b) => b.n - a.n || a.name.localeCompare(b.name, lang));
const list = {
  '@type': 'ItemList',
  '@id': url + '#itemlist',
  numberOfItems: articles.length,
  itemListElement: articles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.entry[lang].data.title,
    url: absUrl(`/blog/${a.slug}/`, lang),
  })),
};
const meta = (a: Article) => ({ date: formatDate(a.published, lang), iso: iso(a.published), minutes: t('article.minutes', { n: a.minutes[lang] }) });
---
<Base
  lang={lang}
  entry={entry}
  crumbs={[{ name: t('nav.blog'), path: '/blog' }]}
  crumbsContainer="container container--wide"
  nodes={[list]}
  pageExtra={{ mainEntity: { '@id': url + '#itemlist' } }}
>
  <div class="container container--wide">
    <section class="hero hero--page">
      <h1 class="t-statement">{t('blog.h1')}</h1>
      <p class="t-secondary mt-2 hero__lead">{t('blog.lead')}</p>
      <p class="t-small mt-4"><a class="link" href={u('/blog/rss.xml', lang)} type="application/rss+xml">{t('blog.rss')}</a> · <a class="link" href={u(`/author/${AUTHOR_SLUG}`, lang)}>{AUTHOR.name}</a></p>
    </section>

    <div class="section section--follow">
      {used.length > 1 && (
        <div class="chips blog-filter" role="group" aria-label={t('blog.topics')} data-blog-filter>
          <button class="chip" type="button" aria-pressed="true" data-topic="">{t('blog.all')}</button>
          {used.map((c) => <button class="chip" type="button" aria-pressed="false" data-topic={c.id}>{c.name}<span class="chip__count">{c.n}</span></button>)}
        </div>
      )}
      {lead && (
        <article class="post-lead" data-topics={lead.categories.join(' ')}>
          <a class="post-lead__cover" href={u(`/blog/${lead.slug}`, lang)} tabindex="-1" aria-hidden="true">
            <ArticleCover article={lead} lang={lang} size="hero" eager />
          </a>
          <div class="post-lead__text">
            <p class="post-card__cat t-meta">{lead.categories.map((c) => names.get(c)).join(' · ')}</p>
            <h2 class="post-lead__title"><a href={u(`/blog/${lead.slug}`, lang)}>{lead.entry[lang].data.title}</a></h2>
            <p class="t-secondary">{lead.entry[lang].data.description}</p>
            <p class="post-card__meta t-meta">
              {AUTHOR.name} · <time datetime={meta(lead).iso}>{meta(lead).date}</time> · {meta(lead).minutes}
              <span data-views={lead.slug} data-label={t('article.views')} hidden> · <span data-views-text></span></span>
            </p>
          </div>
        </article>
      )}

      {rest.length > 0 && (
        <ul class="post-grid mt-16" role="list">
          {rest.map((a) => (
            <li class="post-card" data-topics={a.categories.join(' ')}>
              <a class="post-card__link" href={u(`/blog/${a.slug}`, lang)}>
                <ArticleCover article={a} lang={lang} />
                <span class="post-card__cat t-meta">{a.categories.map((c) => names.get(c)).join(' · ')}</span>
                <span class="post-card__title">{a.entry[lang].data.title}</span>
              </a>
              <p class="post-card__desc t-secondary t-small">{a.entry[lang].data.description}</p>
              <p class="post-card__meta t-meta">
                <time datetime={meta(a).iso}>{meta(a).date}</time> · {meta(a).minutes}
                <span data-views={a.slug} data-label={t('article.views')} hidden> · <span data-views-text></span></span>
              </p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</Base>

<script>
  import { showViews } from '~/scripts/views';
  showViews();

  // topic filter: hides the articles outside the chosen topic
  const bar = document.querySelector<HTMLElement>('[data-blog-filter]');
  if (bar) {
    const items = [...document.querySelectorAll<HTMLElement>('[data-topics]')];
    const grid = document.querySelector<HTMLElement>('.post-grid');
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-topic]');
      if (!btn) return;
      const topic = btn.dataset.topic!;
      for (const b of bar.querySelectorAll('[data-topic]')) b.setAttribute('aria-pressed', String(b === btn));
      for (const el of items) el.hidden = !!topic && !el.dataset.topics!.split(' ').includes(topic);
      // with the lead hidden, the grid moves up to where the lead was
      grid?.classList.toggle('mt-16', !items[0]?.matches('.post-lead') || !items[0].hidden);
    });
  }
</script>
