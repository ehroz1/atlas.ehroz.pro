---
import { u } from '~/lib/url';
import Base from '~/layouts/Base.astro';
import Gallery from '~/components/Gallery.astro';
import { getTools, getCategories, type Category } from '~/lib/data';
import { getPage } from '~/lib/routes';
import { itemList } from '~/lib/schema';
import { absUrl } from '~/lib/seo';
import { useTranslations, loc, type Lang } from '~/i18n';

interface Props { category: Category; lang: Lang }
const { category, lang } = Astro.props;
const t = useTranslations(lang);
const [all, categories, entry] = await Promise.all([getTools(), getCategories(), getPage(`category/${category.id}`)]);
const tools = all.filter((x) => x.data.category === category.id);
const name = loc(category.data.name, lang);
const url = absUrl(entry.path, lang);
const others = categories.filter((c) => c.id !== category.id);
---
<Base
  lang={lang}
  entry={entry}
  crumbs={[{ name: t('nav.categories'), path: '/categories' }, { name, path: entry.path }]}
  nodes={[itemList(url, name, tools, lang)]}
  pageExtra={{ mainEntity: { '@id': url + '#itemlist' } }}
>
  <div class="container container--wide">
    <section class="hero" style="padding-top: clamp(var(--s-8), 6vw, var(--s-20))">
      <h1 class="t-statement">{name}</h1>
      <p class="t-secondary mt-2" style="max-width: 28rem">{loc(category.data.description, lang)}</p>
    </section>

    <div class="section" style="padding-bottom: 0; padding-top: clamp(var(--s-12), 8vw, var(--s-20))">
      <Gallery tools={tools} categories={categories} current={category.id} lang={lang} />
    </div>

    <nav class="section--tight" style="padding-top: var(--s-20); padding-bottom: 0" aria-labelledby="other-categories">
      <h2 class="t-title" id="other-categories">{t('category.others')}</h2>
      <ul class="chips mt-4" role="list">
        {others.map((c) => <li><a class="chip" href={u(`/category/${c.id}`, lang)}>{loc(c.data.name, lang)}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>
