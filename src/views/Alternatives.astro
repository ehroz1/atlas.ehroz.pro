---
import { u } from '~/lib/url';
import Base from '~/layouts/Base.astro';
import ToolCard from '~/components/ToolCard.astro';
import { getTools, getCategories, type Tool } from '~/lib/data';
import { alternativesOf } from '~/lib/related';
import { getPage } from '~/lib/routes';
import { itemList, faqPage } from '~/lib/schema';
import { SITE } from '~/site.config';
import { absUrl } from '~/lib/seo';
import { useTranslations, loc, type Lang } from '~/i18n';

interface Props { tool: Tool; lang: Lang }
const { tool, lang } = Astro.props;
const d = tool.data;
const t = useTranslations(lang);
const [all, categories, entry] = await Promise.all([getTools(), getCategories(), getPage(`alternatives/${tool.id}`)]);
const alternatives = alternativesOf(tool, all);
const names = new Map(categories.map((c) => [c.id, loc(c.data.name, lang)]));
const category = categories.find((c) => c.id === d.category)!;
const heading = t('alt.h1', { name: d.name });
const url = absUrl(entry.path, lang);

// FAQ answers come straight from the catalog data; a question is dropped when it has no answer.
const list = (xs: Tool[]) => xs.map((x) => x.data.name).join(', ');
const free = alternatives.filter((x) => x.data.pricing !== 'paid');
const open = alternatives.filter((x) => x.data.openSource);
const pricingText = [t(`pricing.${d.pricing}`), d.openSource ? t('pricing.openSource') : null].filter(Boolean).join(', ');
const platformsText = d.platforms.length ? d.platforms.join(', ') : 'Web';
const overview = t('alt.overview', {
  name: d.name,
  pricing: pricingText,
  platforms: platformsText,
  summary: loc(d.description, lang),
  count: alternatives.length,
  freeCount: free.length,
});
const compareRows = [tool, ...alternatives];
const siblingAlts = alternatives.filter((r) => alternativesOf(r, all).length >= 2);
const faq = [
  { q: t('alt.q1', { name: d.name }), a: t('alt.a1', { name: d.name, names: list(alternatives) }) },
  free.length > 0 && { q: t('alt.q2', { name: d.name }), a: t('alt.a2', { names: list(free) }) },
  open.length > 0 && { q: t('alt.q3', { name: d.name }), a: t('alt.a3', { names: list(open) }) },
].filter(Boolean) as { q: string; a: string }[];
---
<Base
  lang={lang}
  entry={entry}
  crumbs={[
    { name: names.get(d.category)!, path: `/category/${category.id}` },
    { name: d.name, path: `/tool/${tool.id}` },
    { name: t('alt.crumb'), path: entry.path },
  ]}
  nodes={[itemList(url, heading, alternatives, lang), faqPage(url, faq)]}
  pageExtra={{ mainEntity: { '@id': url + '#itemlist' } }}
>
  <div class="container container--wide">
    <section class="hero" style="padding-top: clamp(var(--s-8), 6vw, var(--s-20))">
      <h1 class="t-statement">{heading}</h1>
      <p class="t-secondary mt-2" style="max-width: 42rem">{overview}</p>
    </section>

    <section class="section--tight" style="padding-top: clamp(var(--s-10), 6vw, var(--s-16)); padding-bottom: 0" aria-labelledby="alt-compare">
      <div class="section-head">
        <h2 class="t-title" id="alt-compare">{t('alt.compare', { name: d.name })}</h2>
      </div>
      <div class="compare-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col">{t('compare.site')}</th>
              <th scope="col">{t('compare.pricing')}</th>
              <th scope="col">{t('compare.code')}</th>
              <th scope="col">{t('compare.platforms')}</th>
              <th scope="col">{t('compare.summary')}</th>
            </tr>
          </thead>
          <tbody>
            {compareRows.map((row) => (
              <tr>
                <td><a class="link" href={u(`/tool/${row.id}`, lang)}>{row.data.name}</a></td>
                <td>{t(`pricing.${row.data.pricing}`)}</td>
                <td>{row.data.openSource ? t('compare.open') : t('compare.closed')}</td>
                <td>{row.data.platforms.length ? row.data.platforms.join(', ') : 'Web'}</td>
                <td>{loc(row.data.summary, lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" style="padding-bottom: 0; padding-top: clamp(var(--s-12), 8vw, var(--s-20))" aria-labelledby="alt-cards">
      <div class="section-head">
        <h2 class="t-title" id="alt-cards">{t('alt.cards', { name: d.name })}</h2>
      </div>
      <div class="cards">
        {alternatives.map((r, i) => <ToolCard tool={r} categoryName={names.get(r.data.category)!} lang={lang} eager={i < 3} />)}
      </div>
    </section>

    <section class="section--tight" style="padding-top: var(--s-20); padding-bottom: 0" aria-labelledby="faq">
      <h2 class="t-title" id="faq">{t('alt.faq')}</h2>
      <div class="faq mt-4" style="max-width: 44rem">
        {faq.map((f, i) => (
          <details class="faq__item" open={i === 0}>
            <summary class="faq__q">{f.q}</summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <nav class="section--tight" style="padding-top: var(--s-20); padding-bottom: 0" aria-label={t('alt.related')}>
      <ul class="chips" role="list">
        <li><a class="chip" href={u(`/tool/${tool.id}`, lang)}>{t('alt.back', { name: d.name })}</a></li>
        <li><a class="chip" href={u(`/category/${category.id}`, lang)}>{t('alt.more', { category: names.get(d.category)! })}</a></li>
        {siblingAlts.map((r) => (
          <li><a class="chip" href={u(`/alternatives/${r.id}`, lang)}>{t('tool.alternatives', { name: r.data.name })}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</Base>
